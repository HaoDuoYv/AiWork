                            }
                            // 灏卞湴鏀跺熬缁堝眬锛氳 usage锛堥儴鍒嗘垚鍔熸寜瀹為檯 usage 钀借处锛?                            state.record_usage_cached(super::usage::UsageBucket::Qoder, cached);
                            state.record_usage_qoder(
                                model,
                                &win_uid,
                                key_id,
                                false,
                                true,
                                duration_ms,
                                pt,
                                ct,
                                Some(ttfb_ms),

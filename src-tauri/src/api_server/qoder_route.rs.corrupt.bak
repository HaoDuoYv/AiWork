/// 排队同号重试上限�?0605 按上游建议退避；超限放回调度轮换防占死并发槽�?const QUEUE_RETRY_LIMIT: u32 = 3;
/// 排队退避缺省秒数（上游 retryAfterSeconds/waitTime 缺失时）
const QUEUE_DEFAULT_BACKOFF_SECS: u64 = 5;
/// 退避上限（上游建议值异常大时钳制）
const QUEUE_BACKOFF_MAX_SECS: u64 = 30;
/// 同一请求内排队等待的**总预�?*（秒�?026-10-19 实机修复）�?///
/// 单账号池（`tried=1`）下，上游持续排�?+ 每次钳制 �?0s 的同号退避，会把一个请�?/// 拖到 **94 �?*仍无任何 token 输出，最后还�?503 `no healthy account available`
/// 收尾——既慢又误导（账号是健康的，只是上游在排队）。排队预算到点即收尾�?/// 429 + 上游建议的退避秒数，客户端按 Retry-After 稍后重试，而不是把并发槽和
/// 客户端超时预算一起耗光�?const QUEUE_WAIT_BUDGET_SECS: u64 = 20;

/// 排队总预算内的收尾文案（流式/非流式共用，便于断言�?fn queue_budget_exhausted_msg(model: &str, waited: u64, next_wait: u64) -> String {
    format!(
        "upstream queue timeout: model {model} still queued after {waited}s (upstream suggests waiting {next_wait}s more) —�?上游排队中，账号与凭证正常；请稍后重试或改用其它模型"
    )
}

/// 排队预算判定（纯函数）：再等 `next` 秒就会超出总预�?�?true（调用方立即收尾�?fn queue_budget_exceeded(waited: u64, next: u64) -> bool {
    waited.saturating_add(next) > QUEUE_WAIT_BUDGET_SECS
}

/// 安全获取 Mutex 锁：若锁被毒化（panic 导致），仍恢复内部数据继续运�?fn safe_lock<'a, T>(m: &'a Mutex<T>) -> std::sync::MutexGuard<'a, T> {
    m.lock().unwrap_or_else(|e| e.into_inner())
}

// ==================== 模型级冷却（审查修复，镜�?wb_route::model_cooldowns�?====================

/// Qoder 模型级冷却表：`{pool_tag}:{裸模型名}` �?(冷却截止时刻, 连续失败次数)�?/// 排队/超限类错误（ErrMeta 分类 Queued）是模型级现象（换账号同样排队），与账号
/// 无关，故进程级静态表语义等价；挂 ApiSharedState 需�?server.rs（他人负责）�?/// 静�?OnceLock 最小改动。失败次数仅�?Server 渐进冷却维护（issue #90 修复①）�?/// 成功即随条目清除�?/// 键带池标签（`qoder_cn:` / `qoder_intl:`，原备忘 G6 的待办现已接线双区）�?/// CN 与国际区是两套互不相通的账号/网关，同名模型（DeepSeek-Flash、GLM-5.3…）
/// 在两边各自排队——裸名做键时，国内区挂上的排队窗口会把国际区请求一起变�?/// 「model qoder-intl/x cooling down」，�?intl 上游其实空闲。池化键后两�?/// 各自进退，与账号 / 目录 / 粘性的双池语义一致。表不做主动回收，残留条目随
/// 冷却窗口自然过期，重启即清零�?static QODER_MODEL_COOLDOWNS: OnceLock<Mutex<HashMap<String, (Instant, u32)>>> = OnceLock::new();

fn cooldown_map() -> &'static Mutex<HashMap<String, (Instant, u32)>> {
    QODER_MODEL_COOLDOWNS.get_or_init(|| Mutex::new(HashMap::new()))
}

/// 冷却表键 `{pool_tag}:{裸模型名}`：① 池标签隔�?CN / INTL（见上）�?/// �?剥掉 `qoder-intl/` 一类区前缀——执行路径与 dispatch 传进来的形态可能一�?/// 带前缀、一处裸名，不归一会给同一模型落两个条目（挂冷却挂不住、清冷却漏清�?fn cooldown_key(pool_tag: &str, model: &str) -> String {
    let bare = crate::tasks::qoder_realm::normalize_model_id(model).1;
    format!("{}:{}", pool_tag.trim(), bare)
}

/// Server 类（5xx/业务 504「上游服务异常」）渐进冷却参数（issue #90 修复①）�?/// 30s 起、连续失败翻倍（30/60/120/240/480），上限 8 分钟（base 30s 左移 4 �?/// �?480s，MAX 取同值保证封顶可达；�?600s 恒不可达与注释矛盾——审查中等项）�?/// 模型级冷却窗口内 dispatch 健康预检（dispatch.rs pool_health）快速回退多源
/// 模型�?Trae/Buddy 池，不再每请求硬打已�?504 �?qoder 上游；成功即�?///（clear_model_cooldown）�?const SERVER_COOLDOWN_BASE_SECS: u64 = 30;
const SERVER_COOLDOWN_MAX_SECS: u64 = 480;

/// 记录模型级冷却：按本次排队退避时长（已钳制）设定截止时刻，保留既有连�?/// 失败计数（排队退避与 Server 渐进冷却共用一张表）。冷却窗口内后续请求�?/// dispatch 健康预检快速回退（多源）/显式 429（单源），执行路径跳过同号退避，
/// 不再每请求空�?5s×3~30s×3�?/// `pool_tag`：请求命中的区域池（`qoder_cn` / `qoder_intl`），冷却按区隔离
fn note_model_cooldown(pool_tag: &str, model: &str, secs: u64) {
    let key = cooldown_key(pool_tag, model);
    cooldown_map()
        .lock()
        .unwrap_or_else(|e| e.into_inner())
        .entry(key)
        // 取较大者：既有 Server 渐进冷却窗口（可能远长于排队建议值）不得�?        // 本次建议值缩短（issue #90 修复①配套语义，queued_cooldown 测试固化�?        .and_modify(|(until, _)| {
            let candidate = Instant::now() + Duration::from_secs(secs);
            if candidate > *until {
                *until = candidate;
            }
        })
        .or_insert_with(|| (Instant::now() + Duration::from_secs(secs), 0));
}

/// Server 类错误（上游 5xx / 业务 504「上游服务异常」）模型级渐进冷�?/// （issue #90 修复①）：冷却窗�?= min(30s × 2^n, 480s)，n = 失败片段数�?/// **递增条件是既有窗口已过期**而非调用次数——流�?HTTP 两路径在 !sent_any
/// 时都�?`break` 逐账号换号，一次请求内连续换号会对同一模型记账多次；若�?/// 调用次数递增�? 账号一次请求即可把窗口推到 480s，把「跨片段渐进」放大成
/// 「单请求轮换放大」，恢复探测被拉长到 8 分钟。按片段计数后：同请求内换号
/// （窗口未过期）不递增，探测节�?= 冷却窗口�?0s�?0s→…→8min），成功即清�?fn note_model_server_cooldown(pool_tag: &str, model: &str) {
    let key = cooldown_key(pool_tag, model);
    cooldown_map()
        .lock()
        .unwrap_or_else(|e| e.into_inner())
        .entry(key)
        .and_modify(|(until, fails)| {
            // 既有窗口已过�?= 新一次失败片�?�?递增并重设窗口；未过�?=
            // 同片段内的换�?并发失败，窗口维持原截止时刻不后延（审查中等项：
            // 原实现每次失败都�?until 推到 now+delay，持续失败可把窗口无�?            // 滑动后延，恢复探测被不断推迟——半开探测语义由「窗口到期后下一�?            // 请求自然放行」保证，无需额外探测机制�?            if Instant::now() >= *until {
                *fails = fails.saturating_add(1);
                // saturating_sub：fails 可能�?0（note_model_cooldown 排队退避路�?                // or_insert �?(until, 0) 条目）——裸 `*fails - 1` 会下溢（debug panic /
                // release 回绕�?min(4) 恒取 4、冷却被错误推到 480s�?                let delay = (SERVER_COOLDOWN_BASE_SECS
                    << (*fails).saturating_sub(1).min(4))
                .min(SERVER_COOLDOWN_MAX_SECS);
                *until = Instant::now() + Duration::from_secs(delay);
            } else if *fails == 0 {
                // 排队退避落下的短窗（fails=0）：Server 失败应至少抬到基准窗
                // �?s 排队窗不足以覆盖 5xx），但不递增计数（同片段语义�?                // fails>=1 �?Server 冷却窗维持「未过期不后延」防滑动�?                let cand = Instant::now() + Duration::from_secs(SERVER_COOLDOWN_BASE_SECS);
                if cand > *until {
                    *until = cand;
                }
            }
        })
        .or_insert_with(|| {
            (
                Instant::now() + Duration::from_secs(SERVER_COOLDOWN_BASE_SECS),
                1,
            )
        });
}

/// 模型冷却剩余秒数；None = 无冷却（过期残留条目�?wb 版语义按无冷却处理）�?/// 秒数**向上取整**：`as_secs()` 截断会把剩余 1.4s 报成 1s（客户端 1s 后重�?/// 仍在窗口�?�?再来一�?429），剩余 <1s 更会报成 0s（「retry after 0s」）�?pub fn model_cooling_remaining_secs(pool_tag: &str, model: &str) -> Option<u64> {
    let key = cooldown_key(pool_tag, model);
    let map = cooldown_map().lock().unwrap_or_else(|e| e.into_inner());
    let until = map.get(&key)?;
    let left = until.0.saturating_duration_since(Instant::now());
    if left.is_zero() {
        None
    } else {
        Some(left.as_secs() + u64::from(left.subsec_nanos() > 0))
    }
}

/// 请求成功后清除该模型冷却（同 wb_route::clear_model_failure 语义）；连续
/// 失败计数随条目一并清除（成功 = 该模型恢复服务，渐进冷却从基准值起步）
fn clear_model_cooldown(pool_tag: &str, model: &str) {
    cooldown_map()
        .lock()
        .unwrap_or_else(|e| e.into_inner())
        .remove(&cooldown_key(pool_tag, model));
}

/// 执行路径的冷却门（bug 修复：尾巴放行必须两端一致）
///
/// dispatch 侧的 `SHORT_COOLDOWN_GRACE_SECS` 已把窗口尾巴当健康放行，但执�?/// 路径里「已在冷却中 �?立刻终止轮换」的分支仍会把它打回 429——实测日志就�?/// `[SCHED] 冷却尾巴宽松放行` 紧跟一�?`429 模型冷却中，终止轮换`，放行等于白做�?/// 这里统一口径：尾巴（剩余 �?阈值）睡完窗口后继续同号重试；只有真窗口才终止�?enum CooldownGate {
    /// 无活动冷却（过期残留条目同无冷却）——调用方按原路径记窗�?+ 退避重�?    None,
    /// 尾巴已等完——调用方直接重试本轮（不重复记窗�?退避）
    Waited,
    /// 窗口仍长：硬终止（调用方�?429，附剩余秒数�?    Hard(u64),
    /// 等尾巴期间客户端断连——调用方收尾返回
    Disconnected,
}

fn cooldown_gate(
    pool_tag: &str,
    model: &str,
    tx: Option<&tokio::sync::mpsc::Sender<Result<bytes::Bytes, std::io::Error>>>,
) -> CooldownGate {
    let Some(rem) = model_cooling_remaining_secs(pool_tag, model) else {
        return CooldownGate::None;
    };
    if rem > super::dispatch::SHORT_COOLDOWN_GRACE_SECS {
        return CooldownGate::Hard(rem);
    }
    // +120ms 余量：窗口按整秒向上取整，睡�?rem 秒后可能仍差几十毫秒
    let total = Duration::from_millis(rem * 1000 + 120);
    if !sleep_interruptible(total, tx) {
        return CooldownGate::Disconnected;
    }
    CooldownGate::Waited
}

/// last_error 时间戳（UTC+8，与 app 日志时间线同区，issue #90 修复②）�?/// 504 类上游异常是否持续、何时开始，用户此前只能靠猜（正是「切换模型导致�?/// 误解的成因），带时刻后可与日志逐行对照
fn now_cn_timestamp() -> String {
    use chrono::FixedOffset;
    let cn = FixedOffset::east_opt(8 * 3600).expect("UTC+8 offset is valid");
    chrono::Utc::now()
        .with_timezone(&cn)
        .format("%Y-%m-%d %H:%M:%S")
        .to_string()
}

/// 排队/退避分段等待（审查修复）：�?sleep 切成 �?00ms 片段逐段睡，每段�?/// 检查流通道是否关闭——客户端已断连即提前退出，不再空等数十秒排�?退�?/// 时长；返�?false = 已断连。非流式路径无下行通道可查（handler 返回
/// Response 前无断连通知机制），保持整段 sleep
fn sleep_interruptible(
    total: Duration,
    tx: Option<&tokio::sync::mpsc::Sender<Result<bytes::Bytes, std::io::Error>>>,
) -> bool {
    let mut left = total;
    while !left.is_zero() {
        let step = left.min(Duration::from_millis(500));
        std::thread::sleep(step);
        left = left.saturating_sub(step);
        if let Some(t) = tx {
            if t.is_closed() {
                return false;
            }
        }
    }
    true
}

/// 从上�?usage JSON 提取 Qoder 积分测量（issue #82 T2）：
/// 返回 (credits, original_credits)。credits 取复数字段——单�?`credit` 是旧�?/// 字段，读它恒�?0（qoder2api-hub issue #22 命门），故仅在复数缺失时参与回退�?/// **等价性前�?*：与 Python `or` 链「首值非零即用」等价，仅在上游保证单数
/// credit 恒为 0/缺失时成立；两值同现时�?max（按更高积分计）是有意为之的
/// 保守口径，不追求�?or 链逐值等价。usage 缺失或计费字段都取不�?�?None
/// （调用方�?None 不入账，与「上游未下发 usage 不得伪造」口径一致）
fn extract_billing(usage: Option<&Value>) -> (Option<f64>, Option<f64>) {
    let Some(u) = usage else {
        return (None, None);
    };
    let num = |key: &str| -> Option<f64> {
        u.get(key)
            .and_then(|v| v.as_f64())
            .filter(|n| n.is_finite() && *n >= 0.0)
    };
    let pick = |a: Option<f64>, b: Option<f64>| match (a, b) {
        (Some(x), Some(y)) => Some(x.max(y)),
        (Some(x), None) => Some(x),
        (None, y) => y,
    };
    let credits = pick(num("credits"), num("credit"));
    let original = pick(num("original_credits"), num("original_credit"));
    (credits, original)
}

/// system-reminder 剥离正则（惰性编译一次）：非贪婪跨行匹配整块注入�?fn reminder_re() -> &'static regex::Regex {
    static RE: OnceLock<regex::Regex> = OnceLock::new();
    RE.get_or_init(|| {
        regex::Regex::new(r"(?s)\s*<system-reminder>.*?</system-reminder>\s*")
            .expect("system-reminder regex")
    })
}

/// user 输入包裹标签正则（惰性编译一次）�?user_input> / </user_input>（容忍属性）�?fn user_input_tag_re() -> &'static regex::Regex {
    static RE: OnceLock<regex::Regex> = OnceLock::new();
    RE.get_or_init(|| {
        regex::Regex::new(r"</?user_input[^>]*>").expect("user_input tag regex")
    })
}

/// 剥掉客户端注入的 `<system-reminder>` 块与 `<user_input>` 包裹标签（agent
/// 客户端把它们拼进 user 消息——reminder 前置劫持正文、输入被标签包裹），
/// 剩余即用户原话。剥离后仅剩空白时返回空串（调用方按�?preview 处理）�?fn strip_reminders(text: &str) -> String {
    let no_reminders = reminder_re().replace_all(text, " ");
    let stripped = user_input_tag_re().replace_all(&no_reminders, " ");
    // 连续空白压成单个空格�?trim（多块剥离后常残留空�?空格�?    let mut out = String::with_capacity(stripped.len());
    let mut in_ws = false;
    for ch in stripped.chars() {
        if ch.is_whitespace() {
            in_ws = true;
        } else {
            if in_ws && !out.is_empty() {
                out.push(' ');
            }
            in_ws = false;
            out.push(ch);
        }
    }
    out
}

/// issue #82 问题5：会�?preview——末�?user 消息文本（与 build_upstream_body
/// last_user_text 同款逆序口径），剥离注入�?包裹标签后截 200 字符�?fn session_preview(peek: &Value) -> String {
    let mut text = String::new();
    if let Some(messages) = peek.get("messages").and_then(Value::as_array) {
        for message in messages.iter().rev() {
            if message.get("role").and_then(Value::as_str) == Some("user") {
                text = qoder_upstream::content_to_text(
                    message.get("content").unwrap_or(&Value::Null),
                );
                break;
            }
        }
    }
    strip_reminders(&text).chars().take(200).collect()
}

/// issue #82 问题5：失败路径记账会话上下文。失败时本无上游信封可解�?/// （两处调用恒为占位），恒退化为 uuid 占位（request_id 仅幂等用途，占位�?/// 影响正确性）。成功路径由预解�?id �?session_ctx_from_ids，不经本函数�?fn session_ctx(peek: &Value) -> super::usage::QoderSessionCtx {
    super::usage::QoderSessionCtx::placeholder(session_preview(peek))
}

/// issue #82 审查修复 K：信封顶�?request_id/session_id 提取。信封含完整对话历史
/// （大 body），内层重试循环若每次记账都全量反序列化属热路径冗余�?/// id 随信封恒定，应在信封生成后解析一次、循环内复用（本函数即一次解析的产物源）�?/// 会话聚合扩展：三元组�?chat_record_id（轮键，「展开会话看各轮明细」分组用）�?fn extract_envelope_ids(body: &[u8]) -> Option<(String, String, String)> {
    let v = serde_json::from_slice::<Value>(body).ok()?;
    let get = |k: &str| {
        v.get(k)
            .and_then(Value::as_str)
            .unwrap_or("")
            .to_string()
    };
    let (rid, sid, rec) = (get("request_id"), get("session_id"), get("chat_record_id"));
    (!rid.is_empty()).then_some((rid, sid, rec))
}

/// 由预解析的信�?id 构造记账上下文（id �?None = 无信�?解析失败 �?uuid 占位�?fn session_ctx_from_ids(
    peek: &Value,
    ids: Option<&(String, String, String)>,
) -> super::usage::QoderSessionCtx {
    match ids {
        Some((rid, sid, rec)) => super::usage::QoderSessionCtx {
            request_id: rid.clone(),
            session_id: sid.clone(),
            record_id: rec.clone(),
            ts: chrono::Local::now().timestamp(),
            preview: session_preview(peek),
        },
        None => super::usage::QoderSessionCtx::placeholder(session_preview(peek)),
    }
}

/// resolve 命中条目是否 Global 专属（审查修复：v1 �?CN 网关执行，Global
/// 专属条目调度 resolve 双区兜底判活、执行必死，需在执行入口明确拒绝）�?///
/// qoder_upstream 未暴露分区分目录/兜底表的查询接口（他人文件不可改），判定
/// 基于两路**确定性证�?*，不依赖旧实现「resolve(Global) 结果与命中条�?Value
/// 全等 �?两区同名条目声明必有差异」的脆弱值假设（同名同值场景会误判）：
/// �?list() 并集�?id 去重、Global 侧先注册：标�?"cn" �?Global 侧（远程目录
///    + 静态兜底表）完全无�?id �?CN resolve 的命中必来自 CN �?�?必非专属�?/// �?标注 "global" 时�?resolve 双区优先序差异取第二证据：resolve(Global) �?///    = [Global 目录, CN 目录, CN 兜底, Global 兜底]，resolve(Cn) �?= [CN 目录,
///    Global 目录, Global 兜底, CN 兜底]。两路命�?*不同**条目时可逐源证明
///    CN 侧必有此 id（CN 远程目录�?CN 兜底表至少其一声明）→ 必非专属�?/// �?两路命中全等：既�?pub 接口无法区分「仅 Global 独持」与「两区同名同值�?///    （后者仅可能来自远程目录动态刷新；静态兜底表两区同名条目倍率/档位�?///    不同）。按 v1 �?CN 执行�?fail-closed 策略�?Global 专属：Global �?///    声明了此 id �?CN 侧无任何确定性可得证据，放行只会把请求送进 CN 网关
///    收上游诡异报错，拒绝则走明确�?404 提示通道�?fn entry_is_global_only(model: &str, entry: &Value) -> bool {
    let id = entry.get("id").and_then(Value::as_str).unwrap_or("");
    if id.is_empty() {
        return false; // name/upstreamKey 命中且无 id 的边缘：保守放行
    }
    let Some(listed) = qoder_upstream::list()
        .into_iter()
        .find(|m| m.get("id").and_then(Value::as_str) == Some(id))
    else {
        return false; // list 无此 id（按 name/upstreamKey 命中）：保守放行
    };
    if listed.get("region").and_then(Value::as_str) == Some("cn") {
        return false; // 证据①：Global 侧确定无�?id
    }
    match qoder_upstream::resolve(model, qoder_upstream::QoderRegion::Global) {
        // 证据②：两路命中不同 �?CN 侧至少一源声明此 id（逐源可证，见上）
        Some(g) if g != *entry => false,
        // 全等：CN 侧确定性可得证据缺失，�?fail-closed 策略判专属（见③�?        _ => true,
    }
}

/// 字符边界安全截断（自�?wb_route::safe_slice，私有不可复用）�?/// 字节落点在多字节字符内时回退到前一个边界，避免超长上游响应�?/// 整段进入错误消息/日志
fn safe_slice(s: &str, n: usize) -> &str {
    if let Some(t) = s.get(..n) {
        return t;
    }
    let mut end = n.min(s.len());
    while end > 0 && !s.is_char_boundary(end) {
        end -= 1;
    }
    &s[..end]
}

// ==================== F-80-�?v2 慢请求竞速对冲（取号侧编排，wb_route 同构�?====================

/// 对冲账号在途计数租约（镜像 wb_route::HedgeLease）：构造即 +1（竞速窗�?/// 占用），Drop �?-1——建�?凭证解析失败（闭包内提前返回）、双败、竞速胜�?/// 三类退出路径均恰好释放一次，杜绝计数泄漏导致的账号永�?busy
struct QoderHedgeLease {
    uid: String,
    counter: std::sync::Arc<std::sync::atomic::AtomicU32>,
    /// 对冲账号信封�?(request_id, session_id, record_id)（G4）：对冲请求按对冲账�?uid
    /// 重建信封，两账号信封 id 不同——接管记账必须落对冲账号信封�?id�?    /// 否则�?uid=对冲账号而会话键属主账号信封，归属错�?    session_ids: Option<(String, String, String)>,
}

impl QoderHedgeLease {
    fn acquire(
        state: &ApiSharedState,
        pool_tag: &'static str,
        uid: &str,
        session_ids: Option<(String, String, String)>,
    ) -> Self {
        let counter = state.qoder_pool_for(pool_tag).inflight_handle(uid);
        counter.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
        Self { uid: uid.to_string(), counter, session_ids }
    }
}

impl Drop for QoderHedgeLease {
    fn drop(&mut self) {
        self.counter.fetch_sub(1, std::sync::atomic::Ordering::Relaxed);
    }
}

/// 首字竞速胜者信息：**原始未翻�?*上游行源（Qoder 双层信封翻译在竞速落定后
/// 统一进行，胜者行源经 QoderTranslate 转换�? 生效账号 + 对冲计数租约
struct QoderRaceWin {
    lines: Box<dyn std::iter::Iterator<Item = String> + Send>,
    uid: String,
    hedge: Option<QoderHedgeLease>,
    takeover: bool,
    /// 胜者信封的 (request_id, session_id, record_id)（G4）：主账号胜 = 主信�?id�?    /// 对冲接管 = 对冲信封 id；记账按胜者落定，与会话行 uid 同源
    session_ids: Option<(String, String, String)>,
}

/// 首字竞速（F-80-�?v2，镜�?wb_route::race_first_byte）：对冲关闭（阈�?0�?/// 时与纯首字超时语义完全一致；开启时主请求首字节超阈�?�?从池内取第二账号
/// （走同一 busy 过滤——主账号�?inflight 天然让位，受 F-77 并发上限约束�?/// 发对冲请求，先出首字者胜。对冲请求独立解析凭证（identity 回调）并按对�?/// 账号 uid 重建 agent 信封（session 派生依赖 uid）�?#[allow(clippy::too_many_arguments)]
fn race_qoder_first_byte(
    state: &Arc<ApiSharedState>,
    pool_tag: &'static str,
    primary_uid: &str,
    primary_reader: Box<dyn std::io::Read + Send>,
    peek: &Value,
    entry: &Value,
    model_key: &str,
    model_source: &str,
    tried: &HashSet<String>,
    allowed: Option<&HashSet<String>>,
    dedicated: Option<&str>,
    primary_session_ids: &Option<(String, String, String)>,
) -> Result<QoderRaceWin, ()> {
    let hedge_ms = state
        .qoder_hedge_threshold_ms
        .load(std::sync::atomic::Ordering::Relaxed);
    if hedge_ms == 0 {
        let lines = lines_with_first_byte_timeout(primary_reader)?;
        return Ok(QoderRaceWin {
            lines,
            uid: primary_uid.to_string(),
            hedge: None,
            takeover: false,
            session_ids: primary_session_ids.clone(),
        });
    }
    let state2 = state.clone();
    let tried2 = tried.clone();
    // issue #111：对冲取号与主路径同口径——免费模型豁免积分维度过�?    let free2 = qoder_upstream::entry_is_free(entry);
    let allowed2 = allowed.cloned();
    let dedicated2 = dedicated.map(str::to_string);
    let peek2 = peek.clone();
    let entry2 = entry.clone();
    let mk2 = model_key.to_string();
    let ms2 = model_source.to_string();
    let spawn_backup = move || -> Option<(Box<dyn std::io::Read + Send>, QoderHedgeLease)> {
        let (picked2, ev) = state2
            .qoder_pool_for(pool_tag)
            .pick_excluding_constrained_ev(&tried2, allowed2.as_ref(), dedicated2.as_deref(), free2)?;
        // F-77�?可观测：对冲取号同样记录 busy 让位/降级事件
        if let Some(ev) = ev {
            state2.logger.log_sched_event(&ev);
        }
        // 租约先于凭证解析获取：失败路径随闭包局部变�?Drop 自动 -1
        let creds2 = (state2.qoder_identity.as_ref()? )(&picked2.uid).ok()?;
        let converted2 = qoder_upstream::prepare_qoder_body(&peek2, &entry2, &creds2.uid).ok()?;
        // G4：对冲信�?id 随租约带出，接管记账按对冲账号信封落�?        let session_ids = extract_envelope_ids(&converted2);
        let lease = QoderHedgeLease::acquire(&state2, pool_tag, &picked2.uid, session_ids);
        let reader2 = qoder_upstream::make_qoder_request(&creds2, &converted2, &mk2, &ms2).ok()?;
        Some((reader2, lease))
    };
    match lines_with_first_byte_hedged(primary_reader, hedge_ms, spawn_backup) {
        Ok(out) => {
            let uid = if out.takeover {
                out.hedge
                    .as_ref()
                    .map(|l| l.uid.clone())
                    .unwrap_or_else(|| primary_uid.to_string())
            } else {
                primary_uid.to_string()
            };
            // G4：会�?id 按胜者信封落定——接管取对冲信封 id，主胜取主信�?id
            let session_ids = if out.takeover {
                out.hedge.as_ref().and_then(|l| l.session_ids.clone())
            } else {
                primary_session_ids.clone()
            };
            Ok(QoderRaceWin {
                lines: out.lines,
                uid,
                hedge: out.hedge,
                takeover: out.takeover,
                session_ids,
            })
        }
        Err(()) => Err(()),
    }
}

/// 竞速结束后处理对冲计数与日志（镜像 wb_route::settle_hedge）：
/// 释放对冲账号竞速窗口占用；接管�?guard 重绑到对冲账号；[SCHED] 日志记录
/// hedge_takeover / hedge_lost
fn settle_qoder_hedge(
    state: &ApiSharedState,
    win: &mut QoderRaceWin,
    mut guard: InflightGuard,
    primary_uid: &str,
) -> InflightGuard {
    let Some(lease) = win.hedge.take() else {
        return guard;
    };
    let hedge_uid = lease.uid.as_str();
    if win.takeover {
        state
            .logger
            .log_sched_event(&format!("hedge_takeover primary={} hedge={}", primary_uid, hedge_uid));
        guard = guard.bind_account(lease.counter.clone());
    } else {
        state
            .logger
            .log_sched_event(&format!("hedge_lost primary={} hedge={}", primary_uid, hedge_uid));
    }
    drop(lease);
    guard
}

/// 竞速胜者原始行�?�?翻译�?OpenAI chunk �?�?可中断行源（对冲开启路径）�?/// 对冲关闭�?run_* 直接�?open_qoder_stream（等价实现，少一层迭代器包装�?fn translate_race_lines(
    win: QoderRaceWin,
    err_slot: Arc<Mutex<Option<ErrMeta>>>,
    chat_id: &str,
    model: &str,
) -> InterruptibleLines {
    let translated = qoder_upstream::QoderTranslate::new(win.lines, err_slot, chat_id, model);
    InterruptibleLines::from_iterator(Box::new(translated))
}

// ==================== 流式入口 ====================

/// 定区纯函数（三级优先�?+ 国际池开关回落），`resolve_realm_pool_tag` 的决策核
/// ——无状态便于单测锁定口径：模型前缀 > Key 绑区 > 设置默认区域，INTL 且开�?/// 关闭时回�?CN�?fn realm_pool_tag_from(
    explicit: Option<&'static str>,
    bind_realm: Option<&'static str>,
    default_realm: &str,
    intl_enabled: bool,
) -> &'static str {
    use crate::tasks::qoder_realm;
    let preferred = explicit
        .or(bind_realm)
        .unwrap_or_else(|| qoder_realm::normalize(default_realm));
    let realm = if preferred == qoder_realm::INTL && !intl_enabled {
        qoder_realm::CN
    } else {
        preferred
    };
    qoder_realm::pool_tag(realm)
}

/// 双区定区（与 dispatch 三级路由同源）：客户端模型显式区域前缀 > Key 绑区 >
/// 设置默认区域；默�?前缀�?INTL �?`qoder_intl_enabled` 关闭时回�?CN�?///
/// 为何还要看请求体 model：dispatch 归一化后交给本层的是目录 id（裸名）�?/// `qoder-intl/x` �?`qoder/x` 的区前缀在那里已被消费——只看入参模型名会把
/// 国际区请求判回国内区，取号落到空�?CN 池（国际账号永不就绪的根因之一）�?/// 返回池标签，直接�?`ApiSharedState::qoder_pool_for`�?fn resolve_realm_pool_tag(
    state: &Arc<ApiSharedState>,
    model: &str,
    body_model: Option<&str>,
    key_id: &str,
) -> &'static str {
    use crate::tasks::qoder_realm;
    // 单次取设置（默认区域 + 国际版池开关同源）
    let s: crate::models::Settings = crate::store::db(&state.data_dir).kv_get("app_settings");
    let explicit = qoder_realm::normalize_model_id(model)
        .0
        .or_else(|| body_model.and_then(|m| qoder_realm::normalize_model_id(m).0));
    let key_bind_pool = crate::api_server::api_keys::constraints_for(&state.data_dir, key_id)
        .map(|k| k.bind_pool)
        .unwrap_or_default();
    let bind_realm = crate::api_server::api_keys::pool_realm_of(&key_bind_pool);
    realm_pool_tag_from(
        explicit,
        bind_realm,
        &s.qoder_default_realm,
        s.qoder_intl_enabled,
    )
}

/// Qoder 流式对话（routes.rs 各协议端�?TargetPool::Qoder 分支调用�?pub fn qoder_stream_chat(
    state: Arc<ApiSharedState>,
    body_vec: Vec<u8>,
    model: String,
    start_ts: Instant,
    proto: Protocol,
    key_id: String,
    guard: InflightGuard,
) -> Response {
    let (tx, rx) = tokio::sync::mpsc::channel(64);

    // 批次 D-1 线程隔离：流任务迁入专用阻塞池（�?wb_stream_chat�?    super::stream_runtime().spawn_blocking(move || {
        let chat_id = match proto {
            Protocol::OpenAi => format!("chatcmpl-{}", now_ts()),
            Protocol::OpenAiText => format!("cmpl-{}", now_ts()),
            Protocol::Anthropic => format!("msg_{}", now_ts()),
            Protocol::Responses => format!("resp_{}", now_ts()),
        };

        // SSE keep-alive 15s：watch + DoneSignal 方案（主任务结束�?panic 展开
        // �?done=true，ticker 退出放行流终结）——与 wb_stream_chat 同构
        let (done_tx, mut done_rx) = tokio::sync::watch::channel(false);
        let _done = super::routes::DoneSignal(done_tx);
        {
            let tx2 = tx.clone();
            tokio::spawn(async move {
                let mut tick = tokio::time::interval(std::time::Duration::from_secs(15));
                tick.tick().await; // 首个 tick 立即返回，跳�?                loop {
                    tokio::select! {
                        _ = tick.tick() => {
                            if tx2
                                .send(Ok(bytes::Bytes::from(": keep-alive\n\n")))
                                .await
                                .is_err()
                            {
                                break;
                            }
                        }
                        _ = done_rx.changed() => break,
                    }
                }
            });
        }

        run_qoder_stream(&state, &body_vec, &model, proto, &key_id, &chat_id, &tx, start_ts, guard);
    });

    let stream = ReceiverStream::new(rx);
    Response::builder()
        .header("content-type", "text/event-stream")
        .header("cache-control", "no-cache")
        .header("connection", "keep-alive")
        .body(Body::from_stream(stream))
        .unwrap_or_else(|_| internal_error_response())
}

#[allow(clippy::too_many_arguments)]
fn run_qoder_stream(
    state: &Arc<ApiSharedState>,
    body_vec: &[u8],
    model: &str,
    proto: Protocol,
    key_id: &str,
    chat_id: &str,
    tx: &tokio::sync::mpsc::Sender<Result<bytes::Bytes, std::io::Error>>,
    start_ts: Instant,
    mut guard: InflightGuard,
) {
    // 方案 C：区域池选择——与 dispatch 三级同源（模型前缀 > Key 绑区 > 默认区域），
    // 区前缀可能已被 dispatch 归一化消费，故同时读请求体原�?    let _bare_model = crate::tasks::qoder_realm::normalize_model_id(&model).1;
    // 请求体原值（peek 后续多处复用，先解析一次）
    let peek: Value = serde_json::from_slice(body_vec).unwrap_or(json!({}));
    let body_model = peek.get("model").and_then(Value::as_str);
    let pool_tag = resolve_realm_pool_tag(
        &state,
        &model,
        body_model,
        format!("{key_id}").as_str(),
    );
    let key_name = super::api_keys::key_name_for(&state.data_dir, key_id);

    // 目录条目（upstreamKey/config）：调度命中后目录刷新导致条目消失时�?404 透传�?    // 区域边界：按命中池的区域（pool_tag �?CN/INTL）解析目录，未命中再�?CN �?    // 兜底；上游基址与鉴权由凭证区域决定（qoder_upstream::make_qoder_request /
    // region(creds.realm)），因此 CN 目录条目不会在国际凭证下打往国内网关
    let Some(entry) = qoder_upstream::resolve(
        &_bare_model,
        crate::tasks::qoder_realm::region(pool_tag),
    )
    .or_else(|| qoder_upstream::resolve(&_bare_model, qoder_upstream::QoderRegion::Cn))
    else {
        let msg = format!("model {model} not in Qoder catalog");
        state.logger.log_request(
            "qoder", "POST", "/v1/chat/completions", model, true, 404, "-",
            start_ts.elapsed().as_millis() as u64, &key_name, "", Some(&msg),
        );
        send_stream_error(tx, proto, 404, &msg);
        return;
    };
    // 区域边界执行入口检查（审查修复）：resolve 双区兜底可能命中 Global 专属
    // 条目——调度判活但 CN 网关执行必死，此处明确拒绝（404 可解析通道）而非
    // 透传上游诡异报错
    if pool_tag != "qoder_intl" && entry_is_global_only(model, &entry) {
        let msg = format!(
            "upstream 404 error: model {model} only available in Qoder Global region, not yet supported"
        );
        state.logger.log_request(
            "qoder", "POST", "/v1/chat/completions", model, true, 404, "-",
            start_ts.elapsed().as_millis() as u64, &key_name, "", Some(&msg),
        );
        send_stream_error(tx, proto, 404, &msg);
        return;
    }
    let model_key = entry
        .get("upstreamKey")
        .and_then(Value::as_str)
        .unwrap_or("")
        .to_string();
    let model_source = entry
        .pointer("/config/source")
        .and_then(Value::as_str)
        .unwrap_or("system")
        .to_string();
    // issue #111：免费档模型（倍率 0）零消耗，取号豁免积分维度过滤
    //（零积分/保留阈�?积分过期），账号级状态过滤保持不变�?    // 免费活动覆盖（资源调度页开关）：在地区专属判定之后应用—�?    // entry_is_global_only 比较原始条目相等性，提前改写会破坏判�?    let entry = {
        let mut e = entry;
        qoder_upstream::apply_flash_free_override(
            &mut e,
            state
                .qoder_flash_free_rate
                .load(std::sync::atomic::Ordering::Relaxed),
        );
        e
    };
    let free_model = qoder_upstream::entry_is_free(&entry);

    // F-35 �?Key 约束（qoder 池作用域；匿�?无约�?Key 全空 �?走默认调度）
    let (allowed_set, dedicated) = super::api_keys::constraints_for(&state.data_dir, key_id)
        .and_then(|k| k.pool_constraints("qoder"))
        .map_or((None, None), |c| (c.allowed, c.dedicated));

    // F-80-�?v2 会话粘性（开关关闭时�?None，v1 轮换行为零变化）：粘性命中且
    // 账号在池 �?首选粘住账号（busy 且有空闲候选时让位，F-77�?同构）；�?Key
    // 限定上游不含粘性账号时忽略粘性。同账号 + 同种子派生同一上游 session_id
    //（prepare_qoder_body session_id_for），粘住账号即保住上游会话侧复用
    let sticky_key = SessionKey::from_body(&peek);
    let sticky0: Option<String> = if state
        .qoder_sticky_enabled
        .load(std::sync::atomic::Ordering::Relaxed)
    {
        state
            .qoder_sticky
            .resolve(&sticky_key, now_ts())
            .and_then(|b| {
                if allowed_set.as_ref().is_some_and(|a| !a.contains(&b.uid)) {
                    return None;
                }
                state.qoder_pool_for(pool_tag).pick_by_uid(&b.uid, free_model).map(|_| b.uid)
            })
    } else {
        None
    };
    // 绑定回写用会话种子（仅落库留档；session �?body 构造时�?uid+seed 派生�?    let sticky_seed: String = peek
        .get("session_id")
        .and_then(Value::as_str)
        .or_else(|| peek.get("user").and_then(Value::as_str))
        .unwrap_or("-")
        // 审查 P3：seed �?sticky 存储做会话匹配，超长值放大留档体积—�?        // 限长 128 字符（与上游请求�?session_seed 同款确定性截断）
        .chars()
        .take(128)
        .collect();

    // 首选：粘�?> 调度策略（F-77④：粘性账�?busy 且有空闲候选时让位�?    let mut first_pick: Option<super::pool::PickedAccount> = sticky0.as_ref().and_then(|u| {
        state
            .qoder_pool_for(pool_tag)
            .pick_sticky_yield(u, allowed_set.as_ref(), free_model)
            .map(|(p, ev)| {
                if let Some(ev) = ev {
                    state.logger.log_sched_event(&ev);
                }
                p
            })
    });

    let mut tried: HashSet<String> = HashSet::new();
    let mut empty_hits: usize = 0; // 空完成计数：轮换耗尽收尾区分指纹拦截与账号耗尽
    // 排队累计等待（预算见 QUEUE_WAIT_BUDGET_SECS）与最后一次上游失败分类：
    // 耗尽收尾据此判断「上游一直在排队」还是「账号真不可用�?    let mut queue_waited_secs: u64 = 0;
    let mut last_kind: Option<UpstreamKind> = None;

    loop {
        // 客户端断连检测：通道关闭即终止轮�?重试（对�?run_wb_stream）�?        // 审查 M5：断连也是请求终局，补记一行失败用量（未取�?�?"none"�?        // 与下方轮换耗尽收尾同口径），防用量�?requests 缺口
        if tx.is_closed() {
            state.record_usage_qoder(
                model, "none", key_id, false, true,
                start_ts.elapsed().as_millis() as u64, 0, 0, None, None, None,
                &session_ctx(&peek),
            );
            return;
        }
        // ── 取号：粘性命中优先，否则�?Key 约束 + 调度策略；换号后仅走策略 ──
        let picked = match first_pick.take() {
            Some(p) => p,
            None => match state
                .qoder_pool_for(pool_tag)
                .pick_excluding_constrained_ev(&tried, allowed_set.as_ref(), dedicated.as_deref(), free_model)
            {
                Some((p, ev)) => {
                    if let Some(ev) = ev {
                        state.logger.log_sched_event(&ev);
                    }
                    p
                }
                None => {
                    let duration_ms = start_ts.elapsed().as_millis() as u64;
                    state.record_usage_qoder(model, "none", key_id, false, true, duration_ms, 0, 0, None, None, None, &session_ctx(&peek));
                    // 审查 P2：轮换耗尽收尾对齐 routes.rs（issue #57 可观测）—�?                    // 空完成主�?�?明示渠道指纹拦截语义（账�?模型无关，提示更�?                    // wb_template_map.json），否则维持无健康账号文案；
                    // code 保持 no_healthy_account（客户端兼容�?                    //
                    // 2026-10-19 实机修复：最后一次失败是「上游排队」时不再�?                    // no_healthy_account——账号是好的，是上游在排队。此时按限流语义
                    // 收尾 429（带已等待秒数），并明确「稍后重试」而非「去查账号」�?                    if last_kind == Some(UpstreamKind::Queued) {
                        let msg = queue_budget_exhausted_msg(
                            model,
                            queue_waited_secs,
                            QUEUE_DEFAULT_BACKOFF_SECS,
                        );
                        state.logger.log_request(
                            "qoder", "POST", "/v1/chat/completions", model, true, 429, "none",
                            duration_ms, &key_name, "", Some(&msg),
                        );
                        state.logger.log_debug_line(format!(
                            "[DEBUG] UPSTREAM_QUEUE_TIMEOUT tried={} waited={}s pool=qoder",
                            tried.len(),
                            queue_waited_secs,
                        ));
                        let err_body = json!({
                            "error": {"message": msg, "type": "api_error", "code": "upstream_queue_timeout"}
                        });
                        let _ = tx.blocking_send(Ok(bytes::Bytes::from(format!(
                            "data: {err_body}\n\n"
                        ))));
                        let _ = tx.blocking_send(Ok(bytes::Bytes::from("data: [DONE]\n\n")));
                        return;
                    }
                    let (healthy_total, _) = state.qoder_pool_for(pool_tag).selectable_stats_in(None, free_model);
                    let (exhaust_msg, exhaust_tag) =
                        super::routes::exhaust_message(empty_hits, tried.len(), healthy_total);
                    state.logger.log_request(
                        "qoder", "POST", "/v1/chat/completions", model, true, 503, "none",
                        duration_ms, &key_name, "", Some(&exhaust_msg),
                    );
                    state.logger.log_debug_line(format!(
                        "[DEBUG] {exhaust_tag} tried={} empty_hits={} pool=qoder{}",
                        tried.len(),
                        empty_hits,
                        // issue #99 ①：影子风控（空完成主导）收尾落原始指纹样本（三池同口径�?                        if exhaust_tag == "CHANNEL_FINGERPRINT_BLOCK" {
                            format!(" 指纹样本: {}", super::wb_payload::fingerprint_sample(body_vec))
                        } else {
                            String::new()
                        }
                    ));
                    let err_body = json!({
                        "error": {"message": exhaust_msg, "type": "api_error", "code": "no_healthy_account"}
                    });
                    let _ = tx.blocking_send(Ok(bytes::Bytes::from(format!(
                        "data: {err_body}\n\n"
                    ))));
                    let _ = tx.blocking_send(Ok(bytes::Bytes::from("data: [DONE]\n\n")));
                    return;
                }
            },
        };
        tried.insert(picked.uid.clone());
        // 当前账号排队重试计数（账号局部：换号自然重置�?        let mut queue_same: u32 = 0;
        // F-77 账号级在途计数：取号即绑定（换号�?bind_account 自动解绑旧账号）�?        // 审查 P1-4 TOCTOU 收紧：普通候�?CAS 复核「在�?< 并发上限」，已满�?        // 不发起请求换下一候选（不计错误不冷却）；over_limit 候选（粘性锁定�?        // busy_fallback 降级）保留原无条件绑定语义�?        // active_uid 仅在绑定成功后更新（CAS 拒绝的候选不得污染「当前账号」展示）
        let bound = if picked.over_limit {
            guard = guard.bind_account(state.qoder_pool_for(pool_tag).inflight_handle(&picked.uid));
            true
        } else {
            guard.bind_account_cas(
                state.qoder_pool_for(pool_tag).inflight_handle(&picked.uid),
                state.qoder_pool_for(pool_tag).concurrency_limit(),
            )
        };
        if !bound {
            continue;
        }
        *safe_lock(&state.active_uid) = Some(picked.uid.clone());

        // 凭证解析：回调缺失（未注�?单测）→ 换号不冷却（配置问题非账号问题）�?        // 回调报错（PAT 换令牌失�?登录态失效）�?SessionDead 禁用后换�?        let creds: QoderCreds = match state.qoder_identity.as_ref() {
            None => {
                state.logger.log_request(
                    "qoder", "POST", "/v1/chat/completions", model, true, 503, &picked.uid,
                    start_ts.elapsed().as_millis() as u64, &key_name,
                    &state.qoder_pool_for(pool_tag).name_of(&picked.uid), Some("qoder identity 回调未注�?),
                );
                continue;
            }
            Some(resolve) => match resolve(&picked.uid) {
                Ok(c) => c,
                Err(e) => {
                    // 审查修复：瞬时失败（网络/5xx，带 TRANSIENT_ERR_TAG）记 Server 熔断
                    //（可自愈）；仅永久失�?SessionDead 禁用
                    let kind = if crate::tasks::qoder_common::is_transient_identity_err(&e) {
                        ErrKind::Server
                    } else {
                        ErrKind::SessionDead
                    };
                    state.qoder_pool_for(pool_tag).note_error(&picked.uid, kind);
                    // issue #67：硬冷却/禁用类错误解绑该账号粘�?                    if kind.unbinds_sticky() {
                        state.qoder_sticky.unbind_uid(&picked.uid);
                    }
                    *safe_lock(&state.last_error) = Some(format!(
                        // 审查修复：err 原文（上游响�?URL 片段可能含令牌）截断脱敏�?                        // �?HTTP 分支 safe_slice 口径
                        "qoder identity uid={} err={}",
                        picked.uid,
                        safe_slice(&e, 200)
                    ));
                    state.logger.log_request(
                        "qoder", "POST", "/v1/chat/completions", model, true, 503, &picked.uid,
                        start_ts.elapsed().as_millis() as u64, &key_name,
                        &state.qoder_pool_for(pool_tag).name_of(&picked.uid), Some("凭证解析失败"),
                    );
                    continue;
                }
            },
        };

        // 请求体（agent 信封；依赖账�?uid 派生 session�?        let converted = match qoder_upstream::prepare_qoder_body(&peek, &entry, &creds.uid) {
            Ok(b) => b,
            Err(e) => {
                state.logger.log_request(
                    "qoder", "POST", "/v1/chat/completions", model, true, 500, &picked.uid,
                    start_ts.elapsed().as_millis() as u64, &key_name,
                    &state.qoder_pool_for(pool_tag).name_of(&picked.uid), Some(&e),
                );
                send_stream_error(tx, proto, 500, &e);
                return;
            }
        };

        // 审查修复 K：信封含完整对话历史（大 body），request_id/session_id 随信封恒定，
        // 在外层换号循环内解析一次供内层各次尝试记账复用，避免热路径重复全量反序列化
        let envelope_ids = extract_envelope_ids(&converted);

        let mut same_attempt: u32 = 0;
        // 对冲接管标记（本轮尝试内有效）：接管后排队同号退避不再适用—�?        // 退避重试走主账�?creds/converted，与生效（对冲）账号不一致�?        // 初值在 Ok 分支必然先赋值后读取，lint 对初值误报，显式允许
        #[allow(unused_assignments)]
        let mut hedge_taken = false;
        loop {
            // 断连检测：重试等待/长路径期间离开则终止（guard �?Drop 释放）�?            // 审查 M5：断连为请求终局，补记一行失败用量（已绑�?picked 账号�?            if tx.is_closed() {
                state.record_usage_qoder(
                    model, &picked.uid, key_id, false, true,
                    start_ts.elapsed().as_millis() as u64, 0, 0, None, None, None,
                    &session_ctx(&peek),
                );
                return;
            }
            // F-76�?TTFT 采样（同 wb_route：各次尝试独立计时，竞速胜者首字即 TTFB�?            let ttfb_start = Instant::now();
            match qoder_upstream::make_qoder_request(
                &creds,
                &converted,
                &model_key,
                &model_source,
            ) {
                Ok(reader) => {
                    // 首字超时 10s：超时视为上游故�?�?换号（同 run_wb_stream 语义）；
                    // F-80-�?v2 慢请求竞速对冲：首字超阈值向第二账号发对冲请求，
                    // 先出首字者胜（对冲关闭时与纯首字超时语义一致）
                    let err_slot: Arc<Mutex<Option<ErrMeta>>> = Arc::new(Mutex::new(None));
                    let mut race = match race_qoder_first_byte(
                        state,
                        pool_tag,
                        &picked.uid,
                        reader,
                        &peek,
                        &entry,
                        &model_key,
                        &model_source,
                        &tried,
                        allowed_set.as_ref(),
                        dedicated.as_deref(),
                        &envelope_ids,
                    ) {
                        Ok(w) => w,
                        Err(()) => {
                            state.qoder_pool_for(pool_tag).note_error(&picked.uid, ErrKind::Server);
                            break;
                        }
                    };
                    let ttfb_ms = ttfb_start.elapsed().as_millis() as u64;
                    // 对冲计数落定 + guard 重绑（接管时生效账号 = 对冲账号�?                    guard = settle_qoder_hedge(state, &mut race, guard, &picked.uid);
                    hedge_taken = race.takeover;
                    let win_uid = race.uid.clone();
                    // G4：记账会�?id 按胜者信封落定（race �?translate 处被消费，先取快照）
                    let win_session_ids = race.session_ids.clone().or_else(|| envelope_ids.clone());
                    // 竞速胜者行源（原始上游行）统一翻译后喂 stream_forward_ex
                    let ilines = translate_race_lines(race, err_slot.clone(), chat_id, model);
                    let (error_info, sent_any, failed_inline, usage) =
                        // Qoder �?namespace 展平编码（Responses 分支为防御性兜底，
                        // 实际�?OpenAi/Anthropic 可达）→ 空集合禁用编码名拆分（审�?F4�?                        wb_sse::stream_forward_ex(ilines, tx, proto, chat_id, model, &std::collections::HashSet::new());
                    let duration_ms = start_ts.elapsed().as_millis() as u64;
                    let meta = err_slot
                        .lock()
                        .unwrap_or_else(|e| e.into_inner())
                        .clone();
                    // M1 修复（审查）：as_u64 窄口径对字符�?浮点数字段形态静�?                    // �?0——改�?wb_sse::u64_pair 宽口径（�?wb/Trae 记账同源�?                    let (pt, ct) = usage.as_ref().map(wb_sse::u64_pair).unwrap_or((0, 0));
                    // M4：缓存读 tokens 同源宽口径提取，终态旁路记账（0 值不入账�?                    let cached = usage.as_ref().map(wb_sse::cached_tokens_of).unwrap_or(0);
                    let (credits, original_credits) = extract_billing(usage.as_ref());
                    // issue #111：免费档调度（免费活动覆盖开启或目录�?0）消耗按 0
                    // 落账——上�?billable=false 实际不扣分，名义值照记会虚增用量
                    let (credits, original_credits) = if free_model {
                        (Some(0.0), Some(0.0))
                    } else {
                        (credits, original_credits)
                    };
                    // 审查修复（中等项）：流式记账对齐非流式「每请求一行」口径—�?                    // 不再逐尝试记账（原每次尝试记一条，换号重试�?requests/errors
                    // 虚高）；usage 仅在请求终局（成�?就地收尾/冷却终止/Fatal/取号
                    // 耗尽）处记录，换号中间态（break 继续轮换）不�?                    match error_info {
                        Some((code, msg)) => {
                            // 流内错误分类�?ErrMeta 为准（translate 写入，含排队/额度信号�?                            match meta.as_ref().map(|m| m.kind) {
                                Some(UpstreamKind::Queued) => {
                                    // 排队：同号退避重试为主（对冲接管后不适用——重�?                                    // 凭证/请求体属主账号，与生效账号不一致，直接换号）；
                                    // 若该模型已被并发请求记入冷却，则直接 break 换号
                                    //（快速失败）
                                    if !sent_any && !hedge_taken && queue_same < QUEUE_RETRY_LIMIT {
                                        let secs = meta
                                            .as_ref()
                                            .and_then(|m| m.queue.as_ref())
                                            .and_then(|q| q.retry_after_secs)
                                            .unwrap_or(QUEUE_DEFAULT_BACKOFF_SECS)
                                            .clamp(1, QUEUE_BACKOFF_MAX_SECS);
                                        last_kind = Some(UpstreamKind::Queued);
                                        // 排队总预算：超预算立即收尾（429 + 退避提示）�?                                        // 不再把请求拖到分钟级仍无输出
                                        if queue_budget_exceeded(queue_waited_secs, secs) {
                                            let duration_ms =
                                                start_ts.elapsed().as_millis() as u64;
                                            state.record_usage_qoder(
                                                model, &win_uid, key_id, false, true,
                                                duration_ms, 0, 0, None, None, None,
                                                &session_ctx(&peek),
                                            );
                                            state.logger.log_request(
                                                "qoder", "POST", "/v1/chat/completions",
                                                model, true, 429, &win_uid, duration_ms,
                                                &key_name,
                                                &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                                Some("上游排队超预算，收尾 429"),
                                            );
                                            send_stream_error(
                                                tx, proto, 429,
                                                &queue_budget_exhausted_msg(
                                                    model,
                                                    queue_waited_secs,
                                                    secs,
                                                ),
                                            );
                                            return;
                                        }
                                        // 审查修复：模型级冷却——排队是模型级现象，
                                        // 记录窗口�?dispatch 预检快速回退；已在冷�?                                        // 中（并发请求刚记录过）时�?cooldown_gate 处置�?                                        // 尾巴睡完再试一次，长窗口才终止轮换返回 429�?                                        // 不再对池内每个账号硬打已知故障上�?                                        //（原 break 换号会轮换到耗尽，逐账号真实请求）
                                        match cooldown_gate(pool_tag, model, Some(tx)) {
                                            // 尾巴已等完：直接重试本轮（不再重复记窗口/退避）
                                            CooldownGate::Waited => {
                                                queue_same += 1;
                                                continue;
                                            }
                                            CooldownGate::None => {}
                                            CooldownGate::Hard(rem) => {
                                                let duration_ms =
                                                    start_ts.elapsed().as_millis() as u64;
                                                state.record_usage_qoder(
                                                    model, &win_uid, key_id, false, true,
                                                    duration_ms, 0, 0, None, None, None,
                                                    &session_ctx(&peek),
                                                );
                                                state.logger.log_request(
                                                    "qoder", "POST", "/v1/chat/completions",
                                                    model, true, 429, &win_uid, duration_ms,
                                                    &key_name,
                                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                                    Some("模型冷却中，终止轮换"),
                                                );
                                                send_stream_error(
                                                    tx, proto, 429,
                                                    &format!("model {model} cooling down, retry after {rem}s"),
                                                );
                                                return;
                                            }
                                            CooldownGate::Disconnected => {
                                                // 审查 M5：断连为请求终局，补记失败终态用�?                                                state.record_usage_qoder(
                                                    model, &win_uid, key_id, false, true,
                                                    start_ts.elapsed().as_millis() as u64, 0, 0,
                                                    None, None, None, &session_ctx(&peek),
                                                );
                                                return;
                                            }
                                        }
                                        note_model_cooldown(pool_tag, model, secs);
                                        queue_same += 1;
                                        if !sleep_interruptible(Duration::from_secs(secs), Some(tx)) {
                                            // 审查 M5：断连为请求终局，补记失败终态用�?                                            state.record_usage_qoder(
                                                model, &win_uid, key_id, false, true,
                                                start_ts.elapsed().as_millis() as u64, 0, 0,
                                                None, None, None, &session_ctx(&peek),
                                            );
                                            return; // 客户端断连：提前退�?                                        }
                                        queue_waited_secs = queue_waited_secs.saturating_add(secs);
                                        continue;
                                    }
                                    // 超限/sent_any：不�?break 硬换号——内容已流出
                                    // （sent_any=true）时换号重发会向同一 SSE 流拼�?                                    // 第二份完整响应；交下方公共收尾（!sent_any→换号，
                                    // sent_any→就地收尾），与其他错误分支口径一�?                                }
                                Some(kind) => {
                                    last_kind = Some(kind);
                                    let ek = kind.to_err_kind();
                                    if ek != ErrKind::None {
                                        state.qoder_pool_for(pool_tag).note_error(&win_uid, ek);
                                        // issue #67：硬冷却/禁用类错误解绑该账号粘�?                                        if ek.unbinds_sticky() {
                                            state.qoder_sticky.unbind_uid(&win_uid);
                                        }
                                    }
                                    // issue #90 修复①：上游服务端异常（5xx/业务 504）纳�?                                    // 模型级渐进冷却——仅在内容未流出时记账（sent_any=true
                                    // 说明模型实际在服务，尾部错误帧不代表模型故障�?                                    if kind == UpstreamKind::Server && !sent_any {
                                        note_model_server_cooldown(pool_tag, model);
                                    }
                                    // issue #90 修复②：last_error 带模型名 + 时刻（此前只�?                                    // uid/code/msg，无法定位是哪个模型、故障从何时开始）
                                    *safe_lock(&state.last_error) = Some(format!(
                                        "qoder uid={} model={} code={} msg={} at {}",
                                        win_uid,
                                        model,
                                        code,
                                        msg,
                                        now_cn_timestamp()
                                    ));
                                }
                                None => {
                                    // translate 之外的错误帧。EOF 零完成哨兵（-9901）不�?                                    // translate �?ErrMeta，必落本分支（非「理论不可达」）�?                                    // 上游间歇性空回放属暂态，�?wb_route 口径免熔断，
                                    // 仅由下方 !sent_any 分支换号重试
                                    if super::is_empty_completion(code, &msg) {
                                        empty_hits += 1; // 空完成计数：耗尽收尾区分指纹拦截
                                    } else {
                                        state.qoder_pool_for(pool_tag).note_error(&win_uid, ErrKind::Server);
                                    }
                                }
                            }
                            if !sent_any {
                                // 流未开始：错误不下发，允许换号重试（换号中间态不�?usage�?                                break;
                            }
                            // 就地收尾终局：记 usage（部分成功按实际 usage 落账�?                            state.record_usage_cached(super::usage::UsageBucket::Qoder, cached);
                            state.record_usage_qoder(
                                model,
                                &win_uid,
                                key_id,
                                false,
                                true,
                                duration_ms,
                                pt,
                                ct,
                                Some(ttfb_ms),
                                credits,
                                original_credits,
                                &session_ctx_from_ids(&peek, win_session_ids.as_ref()),
                            );
                            state.logger.log_request_ttfb(
                                "qoder", "POST", "/v1/chat/completions", model, true, 200,
                                &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                &state.qoder_pool_for(pool_tag).name_of(&win_uid), Some(&msg),
                            );
                            return; // 已有数据流出：就地收�?                        }
                        None => {
                            if failed_inline {
                                // 流内失败已就地透传客户端：不重试不记账冷却（同 wb_route�?                                state.logger.log_request_ttfb(
                                    "qoder", "POST", "/v1/chat/completions", model, true, 200,
                                    &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                    Some("流内失败已透传客户�?),
                                );
                                return;
                            }
                            clear_model_cooldown(pool_tag, model); // 审查修复：成功即清模型级冷却
                            state.qoder_pool_for(pool_tag).note_success(&win_uid);
                            // 成功终局：记 usage（审查修复——原逐尝试记账已移除�?                            // 成功行在此统一落账）；M4：缓存读 tokens 旁路同落
                            state.record_usage_cached(super::usage::UsageBucket::Qoder, cached);
                            state.record_usage_qoder(
                                model,
                                &win_uid,
                                key_id,
                                true,
                                true,
                                duration_ms,
                                pt,
                                ct,
                                Some(ttfb_ms),
                                credits,
                                original_credits,
                                &session_ctx_from_ids(&peek, win_session_ids.as_ref()),
                            );
                            // F-80-�?v2：绑定粘性会话（开关开启时；Mutex �?re-check
                            // �?TOCTOU �?StickyStore::bind 保证�?                            if state
                                .qoder_sticky_enabled
                                .load(std::sync::atomic::Ordering::Relaxed)
                            {
                                state.qoder_sticky.bind(&sticky_key, &win_uid, &sticky_seed, now_ts());
                                state.qoder_sticky.save(&state.data_dir);
                            }
                            state.logger.log_request_ttfb(
                                "qoder", "POST", "/v1/chat/completions", model, true, 200,
                                &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                &state.qoder_pool_for(pool_tag).name_of(&win_uid), None,
                            );
                            return;
                        }
                    }
                }
                Err((status, resp_body, retry_after)) => {
                    // HTTP 层分级重试（429/5xx/502 同号退避；401/403/4xx 换号/终止�?                    match retry_plan(status, &resp_body, same_attempt, retry_after) {
                        RetryAction::RetrySame { delay_ms } => {
                            same_attempt += 1;
                            // 审查修复：分�?sleep + 断连感知（原整段 sleep 最�?60s�?                            // 断连后仍空等；原 sleep 后的 is_closed 检查一并合并）
                            if !sleep_interruptible(
                                Duration::from_millis(delay_ms.min(60_000)),
                                Some(tx),
                            ) {
                                // 审查 M5：断连为请求终局，补记失败终态用�?                                state.record_usage_qoder(
                                    model, &picked.uid, key_id, false, true,
                                    start_ts.elapsed().as_millis() as u64, 0, 0,
                                    None, None, None, &session_ctx(&peek),
                                );
                                return;
                            }
                            continue;
                        }
                        RetryAction::SwitchKey => {
                            // Qoder 业务错误常在 403/200 信封里：�?upstream 分类�?                            // 排队�?0605）同号退避优先——模型已在冷却中�?                            // break 换号（快速失败，见下方冷却检查）
                            let classified =
                                qoder_upstream::classify_upstream_error(status, &resp_body);
                            if classified.kind == UpstreamKind::Queued
                                && queue_same < QUEUE_RETRY_LIMIT
                            {
                                let secs = classified
                                    .queue
                                    .as_ref()
                                    .and_then(|q| q.retry_after_secs)
                                    .unwrap_or(QUEUE_DEFAULT_BACKOFF_SECS)
                                    .clamp(1, QUEUE_BACKOFF_MAX_SECS);
                                // 审查修复：模型级冷却（同流内 Queued 分支）—�?                                // 尾巴睡完再试、长窗口才终止轮换返�?429
                                match cooldown_gate(pool_tag, model, Some(tx)) {
                                    CooldownGate::Waited => {
                                        queue_same += 1;
                                        continue;
                                    }
                                    CooldownGate::None => {}
                                    CooldownGate::Hard(rem) => {
                                        let duration_ms = start_ts.elapsed().as_millis() as u64;
                                        state.record_usage_qoder(
                                            model, &picked.uid, key_id, false, true,
                                            duration_ms, 0, 0, None, None, None,
                                            &session_ctx(&peek),
                                        );
                                        state.logger.log_request(
                                            "qoder", "POST", "/v1/chat/completions", model, true,
                                            429, &picked.uid, duration_ms, &key_name,
                                            &state.qoder_pool_for(pool_tag).name_of(&picked.uid),
                                            Some("模型冷却中，终止轮换"),
                                        );
                                        send_stream_error(
                                            tx, proto, 429,
                                            &format!("model {model} cooling down, retry after {rem}s"),
                                        );
                                        return;
                                    }
                                    CooldownGate::Disconnected => {
                                        // 审查 M5：断连为请求终局，补记失败终态用�?                                        state.record_usage_qoder(
                                            model, &picked.uid, key_id, false, true,
                                            start_ts.elapsed().as_millis() as u64, 0, 0,
                                            None, None, None, &session_ctx(&peek),
                                        );
                                        return;
                                    }
                                }
                                note_model_cooldown(pool_tag, model, secs);
                                queue_same += 1;
                                if !sleep_interruptible(Duration::from_secs(secs), Some(tx)) {
                                    // 审查 M5：断连为请求终局，补记失败终态用�?                                    state.record_usage_qoder(
                                        model, &picked.uid, key_id, false, true,
                                        start_ts.elapsed().as_millis() as u64, 0, 0,
                                        None, None, None, &session_ctx(&peek),
                                    );
                                    return; // 客户端断连：提前退�?                                }
                                continue;
                            }
                            let kind = classified.kind.to_err_kind();
                            if kind != ErrKind::None {
                                state.qoder_pool_for(pool_tag).note_error(&picked.uid, kind);
                                // issue #67：硬冷却/禁用类错误解绑该账号粘�?                                if kind.unbinds_sticky() {
                                    state.qoder_sticky.unbind_uid(&picked.uid);
                                }
                            }
                            // issue #90 修复①：HTTP �?5xx（含 504）换号前记模型级
                            // 渐进冷却——否�?504 只逐账号轮换硬打，dispatch 预检
                            // 永不触发跨池回退（issue #90 主诉场景�?                            if classified.kind == UpstreamKind::Server {
                                note_model_server_cooldown(pool_tag, model);
                            }
                            *safe_lock(&state.last_error) = Some(format!(
                                "qoder uid={} model={} status={} body={} at {}",
                                picked.uid,
                                model,
                                status,
                                safe_slice(&resp_body, 200),
                                now_cn_timestamp()
                            ));
                            state.logger.log_request(
                                "qoder", "POST", "/v1/chat/completions", model, true, status,
                                &picked.uid, start_ts.elapsed().as_millis() as u64, &key_name,
                                &state.qoder_pool_for(pool_tag).name_of(&picked.uid),
                                Some(&format!("upstream status={status}")),
                            );
                            break; // 换号
                        }
                        RetryAction::Fatal => {
                            let msg =
                                format!("upstream {} error: {}", status, safe_slice(&resp_body, 300));
                            // 终态记账对齐「每请求一行」口径（审查 F3）：Fatal 是请�?                            // 终局（同 no-healthy 由取号分支记录），此前仅 log_request
                            // 导致用量统计页缺口；ttfb/credits 无失败语义传 None
                            state.record_usage_qoder(model, &picked.uid, key_id, false, true,
                                start_ts.elapsed().as_millis() as u64, 0, 0,
                                None, None, None, &session_ctx(&peek));
                            state.logger.log_request(
                                "qoder", "POST", "/v1/chat/completions", model, true, status,
                                &picked.uid, start_ts.elapsed().as_millis() as u64, &key_name,
                                &state.qoder_pool_for(pool_tag).name_of(&picked.uid), Some(&msg),
                            );
                            send_stream_error(tx, proto, status as i64, &msg);
                            return;
                        }
                    }
                }
            }
        }
    }
}

// ==================== 非流式（上游只回 SSE �?本地聚合�?====================

/// Qoder 非流式对话：聚合 + 协议投影（routes.rs 各协议端点调用）
#[allow(clippy::too_many_arguments)]
pub async fn qoder_aggregate_chat(
    state: Arc<ApiSharedState>,
    body_vec: Vec<u8>,
    model: String,
    stream: bool,
    start_ts: Instant,
    proto: Protocol,
    key_id: String,
    guard: InflightGuard,
) -> Response {
    // 方案 C：区域池选择——与 dispatch 三级同源（模型前缀 > Key 绑区 > 默认区域），
    // 区前缀可能已被 dispatch 归一化消费，故同时读请求体原�?    let _bare_model = crate::tasks::qoder_realm::normalize_model_id(&model).1;
    // 请求体原值：peek 在闭包内多处复用，此处解析一次即可同时供定区与执行使�?    let peek: Value = serde_json::from_slice(&body_vec).unwrap_or(json!({}));
    let body_model = peek.get("model").and_then(Value::as_str);
    let pool_tag = resolve_realm_pool_tag(
        &state,
        &model,
        body_model,
        format!("{key_id}").as_str(),
    );
    let model_out = model.clone();
    // 聚合含分级重试（同号退避最�?60s×N），迁入 stream_runtime 专用阻塞�?    //（同 wb_aggregate_chat；长阻塞占主池会饿死鉴权等短任务�?    let result = super::stream_runtime().spawn_blocking(move || {
        let mut guard = guard;
        let key_name = super::api_keys::key_name_for(&state.data_dir, &key_id);

        // 目录按区解析（pool_tag 决定区域），未命中以 CN 区兜�?        let Some(entry) = qoder_upstream::resolve(
        &_bare_model,
        crate::tasks::qoder_realm::region(pool_tag),
    )
    .or_else(|| qoder_upstream::resolve(&_bare_model, qoder_upstream::QoderRegion::Cn))
    else {
            // 审查修复：走 "upstream {status} error:" 可解析通道——非流式错误
            // 解析按前缀提取状态码，裸消息此前�?503，与流式 404 语义不一�?            return Err(format!("upstream 404 error: model {model} not in Qoder catalog"));
        };
        // 区域边界执行入口检查（审查修复）：�?run_qoder_stream，Global 专属
        // 条目�?*国内版池**执行必死，明确拒绝而非透传上游诡异报错；国际版�?        // （pool_tag == qoder_intl）本就打 Global 网关，应当放行（此前漏此守卫�?        // 国际版专属模型被 404 拦死�?        if pool_tag != "qoder_intl" && entry_is_global_only(&model, &entry) {
            return Err(format!(
                "upstream 404 error: model {model} only available in Qoder Global region, not yet supported"
            ));
        }
        let model_key = entry
            .get("upstreamKey")
            .and_then(Value::as_str)
            .unwrap_or("")
            .to_string();
        let model_source = entry
            .pointer("/config/source")
            .and_then(Value::as_str)
            .unwrap_or("system")
            .to_string();
        // issue #111：免费档模型（倍率 0）零消耗，取号豁免积分维度过滤，同流式路径�?        // 免费活动覆盖（资源调度页开关）在地区专属判定之后应用（同流式注释）
        let entry = {
            let mut e = entry;
            qoder_upstream::apply_flash_free_override(
                &mut e,
                state
                    .qoder_flash_free_rate
                    .load(std::sync::atomic::Ordering::Relaxed),
            );
            e
        };
        let free_model = qoder_upstream::entry_is_free(&entry);

        let (allowed_set, dedicated) =
            super::api_keys::constraints_for(&state.data_dir, &key_id)
                .and_then(|k| k.pool_constraints("qoder"))
                .map_or((None, None), |c| (c.allowed, c.dedicated));

        // F-80-�?v2 会话粘性（�?run_qoder_stream；开关关闭恒 None 保持 v1 行为�?        let sticky_key = SessionKey::from_body(&peek);
        let sticky0: Option<String> = if state
            .qoder_sticky_enabled
            .load(std::sync::atomic::Ordering::Relaxed)
        {
            state
                .qoder_sticky
                .resolve(&sticky_key, now_ts())
                .and_then(|b| {
                    if allowed_set.as_ref().is_some_and(|a| !a.contains(&b.uid)) {
                        return None;
                    }
                    state.qoder_pool_for(pool_tag).pick_by_uid(&b.uid, free_model).map(|_| b.uid)
                })
        } else {
            None
        };
        let sticky_seed: String = peek
            .get("session_id")
            .and_then(Value::as_str)
            .or_else(|| peek.get("user").and_then(Value::as_str))
            .unwrap_or("-")
            .to_string();
        // 首选：粘�?> 调度策略（F-77④：粘性账�?busy 且有空闲候选时让位�?        let mut first_pick: Option<super::pool::PickedAccount> = sticky0.as_ref().and_then(|u| {
            state
                .qoder_pool_for(pool_tag)
                .pick_sticky_yield(u, allowed_set.as_ref(), free_model)
                .map(|(p, ev)| {
                    if let Some(ev) = ev {
                        state.logger.log_sched_event(&ev);
                    }
                    p
                })
        });

        let mut tried: HashSet<String> = HashSet::new();
        let mut empty_hits: usize = 0; // 空完成计数：轮换耗尽收尾区分指纹拦截与账号耗尽
        // 排队累计等待与最后失败分类（与流式路径同口径，见 QUEUE_WAIT_BUDGET_SECS�?        let mut queue_waited_secs: u64 = 0;
        let mut last_kind: Option<UpstreamKind> = None;

        loop {
            // ── 取号：粘性命中优先，否则�?Key 约束 + 调度策略；换号后仅走策略 ──
            let picked = match first_pick.take() {
                Some(p) => p,
                None => match state.qoder_pool_for(pool_tag).pick_excluding_constrained_ev(
                    &tried,
                    allowed_set.as_ref(),
                    dedicated.as_deref(),
                    free_model,
                ) {
                    Some((p, ev)) => {
                        if let Some(ev) = ev {
                            state.logger.log_sched_event(&ev);
                        }
                        p
                    }
                    None => {
                        state.record_usage_qoder(
                            &model,
                            "none",
                            &key_id,
                            false,
                            stream,
                            start_ts.elapsed().as_millis() as u64,
                            0,
                            0,
                            None,
                            None,
                            None,
                            &session_ctx(&peek),
                        );
                        // 审查 P2：轮换耗尽收尾对齐 routes.rs——空完成主导 �?指纹拦截语义
                        // 2026-10-19 实机修复：末次失败是「上游排队」→ 限流语义收尾�?29
                        // 前缀由端点映射为 429），而不是把健康的账号报�?no healthy account
                        if last_kind == Some(UpstreamKind::Queued) {
                            let msg =
                                queue_budget_exhausted_msg(&model, queue_waited_secs, QUEUE_DEFAULT_BACKOFF_SECS);
                            state.logger.log_debug_line(format!(
                                "[DEBUG] UPSTREAM_QUEUE_TIMEOUT tried={} waited={}s pool=qoder",
                                tried.len(),
                                queue_waited_secs,
                            ));
                            return Err(format!("upstream 429 error: {msg}"));
                        }
                        let (healthy_total, _) = state.qoder_pool_for(pool_tag).selectable_stats_in(None, free_model);
                        let (exhaust_msg, exhaust_tag) =
                            super::routes::exhaust_message(empty_hits, tried.len(), healthy_total);
                        // issue #99 ①：影子风控收尾落原始指纹样本（非流式路径无收尾
                        // [DEBUG] 行，就地补齐；三池同口径�?                        if exhaust_tag == "CHANNEL_FINGERPRINT_BLOCK" {
                            state.logger.log_debug_line(format!(
                                "[DEBUG] {exhaust_tag} tried={} empty_hits={} pool=qoder 指纹样本: {}",
                                tried.len(),
                                empty_hits,
                                super::wb_payload::fingerprint_sample(&body_vec),
                            ));
                        }
                        return Err(exhaust_msg);
                    }
                },
            };
            tried.insert(picked.uid.clone());
            // 当前账号排队重试计数（账号局部：换号自然重置�?            let mut queue_same: u32 = 0;
            // 审查 P1-4 TOCTOU 收紧：普通候�?CAS 复核「在�?< 并发上限」，已满�?            // 不发起请求换下一候选（不计错误不冷却）；over_limit 候选（粘性锁定�?            // busy_fallback 降级）保留原无条件绑定语义�?            // active_uid 仅在绑定成功后更新（CAS 拒绝的候选不得污染「当前账号」展示）
            let bound = if picked.over_limit {
                guard = guard.bind_account(state.qoder_pool_for(pool_tag).inflight_handle(&picked.uid));
                true
            } else {
                guard.bind_account_cas(
                    state.qoder_pool_for(pool_tag).inflight_handle(&picked.uid),
                    state.qoder_pool_for(pool_tag).concurrency_limit(),
                )
            };
            if !bound {
                continue;
            }
            *safe_lock(&state.active_uid) = Some(picked.uid.clone());

            let creds: QoderCreds = match state.qoder_identity.as_ref() {
                None => continue, // 回调未注入：换号（tried 增长自然耗尽�?503�?                Some(resolve) => match resolve(&picked.uid) {
                    Ok(c) => c,
                    Err(e) => {
                        // 审查修复：瞬时失败走 Server 熔断可自愈（同流式路径）
                        let kind = if crate::tasks::qoder_common::is_transient_identity_err(&e) {
                            ErrKind::Server
                        } else {
                            ErrKind::SessionDead
                        };
                        state.qoder_pool_for(pool_tag).note_error(&picked.uid, kind);
                        // issue #67：硬冷却/禁用类错误解绑该账号粘�?                        if kind.unbinds_sticky() {
                            state.qoder_sticky.unbind_uid(&picked.uid);
                        }
                        *safe_lock(&state.last_error) = Some(format!(
                            // 审查修复：同流式分支，err 原文截断脱敏
                            "qoder identity uid={} err={}",
                            picked.uid,
                            safe_slice(&e, 200)
                        ));
                        continue;
                    }
                },
            };

            let converted = match qoder_upstream::prepare_qoder_body(&peek, &entry, &creds.uid) {
                Ok(b) => b,
                Err(e) => return Err(e),
            };
            // 审查修复 K：信�?id 在外层解析一次，内层记账复用（同流式路径�?            let envelope_ids = extract_envelope_ids(&converted);

            let mut same_attempt: u32 = 0;
            // 对冲接管标记：接管后排队同号退避不适用（重试凭�?请求体属主账号）
            #[allow(unused_assignments)]
            let mut hedge_taken = false;
            loop {
                // F-76�?TTFT 采样（同 wb_route 聚合：各轮独立计时，最终轮即最终回�?TTFT�?                let ttfb_start = Instant::now();
                match qoder_upstream::make_qoder_request(
                    &creds,
                    &converted,
                    &model_key,
                    &model_source,
                ) {
                    Ok(reader) => {
                        let err_slot: Arc<Mutex<Option<ErrMeta>>> = Arc::new(Mutex::new(None));
                        // 首字超时 10s + F-80-�?v2 竞速对冲（对冲关闭时与纯首�?                        // 超时语义一致）：超�?双败视为上游故障 �?换号
                        let mut race = match race_qoder_first_byte(
                            &state,
                            pool_tag,
                            &picked.uid,
                            reader,
                            &peek,
                            &entry,
                            &model_key,
                            &model_source,
                            &tried,
                            allowed_set.as_ref(),
                            dedicated.as_deref(),
                            &envelope_ids,
                        ) {
                            Ok(w) => w,
                            Err(()) => {
                                state.qoder_pool_for(pool_tag).note_error(&picked.uid, ErrKind::Server);
                                break;
                            }
                        };
                        let ttfb_ms = ttfb_start.elapsed().as_millis() as u64;
                        // 对冲计数落定 + guard 重绑（接管时生效账号 = 对冲账号�?                        guard = settle_qoder_hedge(&state, &mut race, guard, &picked.uid);
                        hedge_taken = race.takeover;
                        let win_uid = race.uid.clone();
                        // G4：记账会�?id 按胜者信封落定（race 在聚合处被部分消费，先取快照�?                        let win_session_ids = race.session_ids.clone().or_else(|| envelope_ids.clone());
                        // 竞速胜者原始行�?�?翻译 �?聚合（tool_calls 合并/usage 收集）；
                        // 首字超时已在 race 内裁定，聚合阶段无失败通道
                        let agg_chat_id = format!("chatcmpl-{}", now_ts());
                        let translated =
                            qoder_upstream::QoderTranslate::new(race.lines, err_slot.clone(), &agg_chat_id, &model);
                        let (resp, error) = wb_sse::aggregate(translated, &agg_chat_id);
                        let duration_ms = start_ts.elapsed().as_millis() as u64;
                        match (resp, error) {
                            (Some(mut r), None) => {
                                r["model"] = json!(model);
                                // M1 修复（审查）：as_u64 窄口径改 wb_sse::u64_pair
                                // 宽口径（字符�?浮点形态不再静默得 0�?                                let (pt, ct) = r.get("usage").map(wb_sse::u64_pair).unwrap_or((0, 0));
                                let (credits, original_credits) =
                                    extract_billing(r.get("usage"));
                                // issue #111：免费档调度消耗按 0 落账（同流式路径注释�?                                let (credits, original_credits) = if free_model {
                                    (Some(0.0), Some(0.0))
                                } else {
                                    (credits, original_credits)
                                };
                                // M4：缓存读 tokens 旁路记账（成功终局�? 值不入账�?                                state.record_usage_cached(
                                    super::usage::UsageBucket::Qoder,
                                    r.get("usage").map(wb_sse::cached_tokens_of).unwrap_or(0),
                                );
                                state.record_usage_qoder(
                                    &model, &win_uid, &key_id, true, stream, duration_ms, pt, ct,
                                    Some(ttfb_ms),
                                    credits,
                                    original_credits,
                                    &session_ctx_from_ids(&peek, win_session_ids.as_ref()),
                                );
                                clear_model_cooldown(pool_tag, &model); // 审查修复：成功即清模型级冷却
                                state.qoder_pool_for(pool_tag).note_success(&win_uid);
                                // F-80-�?v2：绑定粘性会话（开关开启时；同流式路径�?                                if state
                                    .qoder_sticky_enabled
                                    .load(std::sync::atomic::Ordering::Relaxed)
                                {
                                    state.qoder_sticky.bind(&sticky_key, &win_uid, &sticky_seed, now_ts());
                                    state.qoder_sticky.save(&state.data_dir);
                                }
                                state.logger.log_request_ttfb(
                                    "qoder", "POST", "/v1/chat/completions", &model, stream, 200,
                                    &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid), None,
                                );
                                return Ok(r);
                            }
                            (None, Some((code, msg))) => {
                                let meta = err_slot
                                    .lock()
                                    .unwrap_or_else(|e| e.into_inner())
                                    .clone();
                                match meta.as_ref().map(|m| m.kind) {
                                    Some(UpstreamKind::Queued) => {
                                        // 排队：同号退避重试为主（对冲接管后不适用�?                                        // 同流式路径——直接换号）；模型已在冷却中
                                        // �?break 换号（快速失败，见下方冷却检查）
                                        if !hedge_taken && queue_same < QUEUE_RETRY_LIMIT {
                                            let secs = meta
                                                .as_ref()
                                                .and_then(|m| m.queue.as_ref())
                                                .and_then(|q| q.retry_after_secs)
                                                .unwrap_or(QUEUE_DEFAULT_BACKOFF_SECS)
                                                .clamp(1, QUEUE_BACKOFF_MAX_SECS);
                                            last_kind = Some(UpstreamKind::Queued);
                                            // 排队总预算：超预算即收尾�?29 前缀由端�?                                            // 映射�?429），不再把请求拖到分钟级
                                            if queue_budget_exceeded(queue_waited_secs, secs) {
                                                state.record_usage_qoder(
                                                    &model, &win_uid, &key_id, false, stream,
                                                    duration_ms, 0, 0, None, None, None,
                                                    &session_ctx(&peek),
                                                );
                                                let msg = queue_budget_exhausted_msg(
                                                    &model,
                                                    queue_waited_secs,
                                                    secs,
                                                );
                                                state.logger.log_request_ttfb(
                                                    "qoder", "POST", "/v1/chat/completions",
                                                    &model, stream, 429, &win_uid, duration_ms,
                                                    Some(ttfb_ms), &key_name,
                                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                                    Some("上游排队超预算，收尾 429"),
                                                );
                                                return Err(format!("upstream 429 error: {msg}"));
                                            }
                                            // 审查修复：模型级冷却（同流式分支）—�?                                            // 冷却中直接终止轮换返�?429（upstream
                                            // 前缀借助端点状态码透传映射），不再逐账号硬�?                                            match cooldown_gate(pool_tag, &model, None) {
                                                CooldownGate::Waited => {
                                                    queue_same += 1;
                                                    continue;
                                                }
                                                CooldownGate::None => {}
                                                CooldownGate::Hard(rem) => {
                                                    state.record_usage_qoder(
                                                        &model, &win_uid, &key_id, false, stream,
                                                        duration_ms, 0, 0, None, None, None,
                                                        &session_ctx(&peek),
                                                    );
                                                    state.logger.log_request_ttfb(
                                                        "qoder", "POST", "/v1/chat/completions",
                                                        &model, stream, 429, &win_uid, duration_ms,
                                                        Some(ttfb_ms), &key_name,
                                                        &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                                        Some("模型冷却中，终止轮换"),
                                                    );
                                                    return Err(format!(
                                                        "upstream 429 error: model {model} cooling down, retry after {rem}s"
                                                    ));
                                                }
                                                // 非流式无下行通道（tx=None）→ 不会断连
                                                CooldownGate::Disconnected => {}
                                            }
                                            note_model_cooldown(pool_tag, &model, secs);
                                            queue_same += 1;
                                            // 统一�?sleep_interruptible(None)：分段等待，
                                            // 与流式实现口径一致（非流式无下行通道�?None�?                                            // 语义等同整段 sleep，仅封装统一�?                                            sleep_interruptible(Duration::from_secs(secs), None);
                                            queue_waited_secs = queue_waited_secs.saturating_add(secs);
                                            continue;
                                        }
                                        break; // 超限换号
                                    }
                                    Some(kind) => {
                                        last_kind = Some(kind);
                                        let ek = kind.to_err_kind();
                                        if ek != ErrKind::None {
                                            state.qoder_pool_for(pool_tag).note_error(&win_uid, ek);
                                            // issue #67 审查修复：账号级长冷却解绑粘性（与流式分支口径对齐）
                                            if ek.unbinds_sticky() {
                                                state.qoder_sticky.unbind_uid(&win_uid);
                                            }
                                        }
                                        // issue #90 修复①：同流式分支（非流式无部分流出概念�?                                        if kind == UpstreamKind::Server {
                                            note_model_server_cooldown(pool_tag, &model);
                                        }
                                    }
                                    None => {
                                        state.qoder_pool_for(pool_tag).note_error(&win_uid, ErrKind::Server);
                                    }
                                }
                                *safe_lock(&state.last_error) = Some(format!(
                                    "qoder uid={} model={} code={} msg={} at {}",
                                    win_uid,
                                    model,
                                    code,
                                    msg,
                                    now_cn_timestamp()
                                ));
                                state.logger.log_request_ttfb(
                                    "qoder", "POST", "/v1/chat/completions", &model, stream, 200,
                                    &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid), Some(&msg),
                                );
                                // 流内错误且未产出内容 �?换号重试
                                break;
                            }
                            _ => {
                                // (None, None)：EOF 零完成（影子风控/上游异常）——计数后换号
                                empty_hits += 1;
                                state.qoder_pool_for(pool_tag).note_error(&win_uid, ErrKind::Server);
                                state.logger.log_request_ttfb(
                                    "qoder", "POST", "/v1/chat/completions", &model, stream, 502,
                                    &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                    Some("empty response"),
                                );
                                break;
                            }
                        }
                    }
                    Err((status, resp_body, retry_after)) => {
                        match retry_plan(status, &resp_body, same_attempt, retry_after) {
                            RetryAction::RetrySame { delay_ms } => {
                                same_attempt += 1;
                                sleep_interruptible(
                                    Duration::from_millis(delay_ms.min(60_000)),
                                    None,
                                );
                                continue;
                            }
                            RetryAction::SwitchKey => {
                                let classified =
                                    qoder_upstream::classify_upstream_error(status, &resp_body);
                                if classified.kind == UpstreamKind::Queued
                                    && queue_same < QUEUE_RETRY_LIMIT
                                {
                                    let secs = classified
                                        .queue
                                        .as_ref()
                                        .and_then(|q| q.retry_after_secs)
                                        .unwrap_or(QUEUE_DEFAULT_BACKOFF_SECS)
                                        .clamp(1, QUEUE_BACKOFF_MAX_SECS);
                                    // 审查修复：模型级冷却（同流式分支）——冷却中
                                    // 直接终止轮换返回 429，不再逐账号硬�?                                    match cooldown_gate(pool_tag, &model, None) {
                                        CooldownGate::Waited => {
                                            queue_same += 1;
                                            continue;
                                        }
                                        CooldownGate::None => {}
                                        CooldownGate::Hard(rem) => {
                                            state.record_usage_qoder(&model, &picked.uid, &key_id,
                                                false, stream,
                                                start_ts.elapsed().as_millis() as u64, 0, 0,
                                                None, None, None, &session_ctx(&peek));
                                            state.logger.log_request(
                                                "qoder", "POST", "/v1/chat/completions", &model,
                                                stream, 429, &picked.uid,
                                                start_ts.elapsed().as_millis() as u64, &key_name,
                                                &state.qoder_pool_for(pool_tag).name_of(&picked.uid),
                                                Some("模型冷却中，终止轮换"),
                                            );
                                            return Err(format!(
                                                "upstream 429 error: model {model} cooling down, retry after {rem}s"
                                            ));
                                        }
                                        // 非流式无下行通道（tx=None）→ 不会断连
                                        CooldownGate::Disconnected => {}
                                    }
                                    note_model_cooldown(pool_tag, &model, secs);
                                    queue_same += 1;
                                    // 审查 Low：对齐同函数其余非流式退避点，统一�?                                    // sleep_interruptible(None)（分段等待，非流式无
                                    // 下行通道�?None，语义等同整�?sleep，仅封装统一�?                                    sleep_interruptible(Duration::from_secs(secs), None);
                                    continue;
                                }
                                let kind = classified.kind.to_err_kind();
                                if kind != ErrKind::None {
                                    state.qoder_pool_for(pool_tag).note_error(&picked.uid, kind);
                                    // issue #67：硬冷却/禁用类错误解绑该账号粘�?                                    if kind.unbinds_sticky() {
                                        state.qoder_sticky.unbind_uid(&picked.uid);
                                    }
                                }
                                // issue #90 修复①：同流�?HTTP 分支�?xx 换号前记模型级冷却）
                                if classified.kind == UpstreamKind::Server {
                                    note_model_server_cooldown(pool_tag, &model);
                                }
                                *safe_lock(&state.last_error) = Some(format!(
                                    "qoder uid={} model={} status={} body={} at {}",
                                    picked.uid,
                                    model,
                                    status,
                                    safe_slice(&resp_body, 200),
                                    now_cn_timestamp()
                                ));
                                // 记账口径对齐流式路径（每请求一行）：换号中间态不�?                                // usage（原聚合路径每次换号多记一条失败，qoder �?                                // requests/errors 虚高）；最�?no-healthy 由取号分支记�?                                state.logger.log_request(
                                    "qoder", "POST", "/v1/chat/completions", &model, stream,
                                    status, &picked.uid,
                                    start_ts.elapsed().as_millis() as u64, &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&picked.uid),
                                    Some(&format!("upstream status={status}")),
                                );
                                break;
                            }
                            RetryAction::Fatal => {
                                // 终态记账对齐「每请求一行」口径（审查 F3）：Fatal �?                                // 请求终局（同 no-healthy 由取号分支记录），此前仅
                                // log_request 导致用量统计页缺�?                                state.record_usage_qoder(&model, &picked.uid, &key_id, false, stream,
                                    start_ts.elapsed().as_millis() as u64, 0, 0,
                                    None, None, None, &session_ctx(&peek));
                                state.logger.log_request(
                                    "qoder", "POST", "/v1/chat/completions", &model, stream,
                                    status, &picked.uid,
                                    start_ts.elapsed().as_millis() as u64, &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&picked.uid),
                                    Some(&safe_slice(&resp_body, 300)),
                                );
                                return Err(format!(
                                    "upstream {} error: {}",
                                    status,
                                    safe_slice(&resp_body, 300)
                                ));
                            }
                        }
                    }
                }
            }
        }
    })
    .await;

    match result {
        Ok(Ok(resp)) => {
            let body = match proto {
                Protocol::Anthropic => wb_sse::completion_to_anthropic(
                    &resp,
                    &format!("msg_{}", now_ts()),
                    &model_out,
                ),
                Protocol::OpenAiText => wb_sse::completion_to_text(&resp, &model_out),
                Protocol::Responses => super::wb_responses::completion_to_responses(
                    &resp,
                    &format!("resp_{}", now_ts()),
                    &model_out,
                    // Qoder �?namespace 展平编码（Responses 分支为防御性兜底）
                    &std::collections::HashSet::new(),
                ),
                Protocol::OpenAi => resp,
            };
            Response::builder()
                .header("content-type", "application/json")
                .body(Body::from(body.to_string()))
                .unwrap_or_else(|_| internal_error_response())
        }
        Ok(Err(msg)) => {
            // 审查修复（对�?wb_aggregate_chat）：Fatal 错误透传上游状态码—�?            // 上游 400/404/413 等请求级错误不降�?503，避免严格客户端无意义重试；
            // 401/403 维持 503 语义�?29 为模型冷却主动限流（审查中等项），透传
            // 让客户端�?Retry-After 语义退避而非立即重试
            let upstream_status = msg
                .strip_prefix("upstream ")
                .and_then(|rest| rest.split(' ').next())
                .and_then(|s| s.parse::<u16>().ok());
            let status = match upstream_status {
                Some(s) if (400..500).contains(&s) && !matches!(s, 401 | 403) => {
                    StatusCode::from_u16(s).unwrap_or(StatusCode::SERVICE_UNAVAILABLE)
                }
                _ => StatusCode::SERVICE_UNAVAILABLE,
            };
            let resp = match proto {
                Protocol::Anthropic => anthropic_error(status, "api_error", &msg),
                _ => openai_error(status, "upstream_error", &msg),
            };
            // 429 的冷却剩余秒数只在文案里（Err(String) 无结构通道）——回收后补成
            // Retry-After 头，客户端才按「还剩几秒」退避而不是自己猜
            match (status, super::routes::retry_after_in_msg(&msg)) {
                (StatusCode::TOO_MANY_REQUESTS, Some(secs)) => {
                    super::routes::with_retry_after(resp, secs)
                }
                _ => resp,
            }
        }
        Err(e) => openai_error(
            StatusCode::INTERNAL_SERVER_ERROR,
            "internal_error",
            &format!("task join error: {}", e),
        ),
    }
}

// ==================== 小工�?====================

fn now_ts() -> i64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.as_secs() as i64)
        .unwrap_or(0)
}

/// 流内错误帧下发（自抄 send_stream_error_wb：私有不可复用；形态同构）
fn send_stream_error(
    tx: &tokio::sync::mpsc::Sender<Result<bytes::Bytes, std::io::Error>>,
    proto: Protocol,
    code: i64,
    msg: &str,
) {
    let msg = stream_msg_or_fallback(msg, code);
    match proto {
        Protocol::Anthropic => {
            let err = json!({"type":"error","error":{"type":"api_error","message":msg}});
            let _ = tx.blocking_send(Ok(bytes::Bytes::from(format!(
                "event: error\ndata: {}\n\n",
                err
            ))));
        }
        Protocol::Responses => {
            let resp = json!({
                "id": format!("resp_{}", now_ts()),
                "object": "response",
                "status": "failed",
                "output": [],
                "error": {"code": code.to_string(), "message": msg},
            });
            let body = json!({"type": "response.failed", "response": resp});
            let _ = tx.blocking_send(Ok(bytes::Bytes::from(format!(
                "event: response.failed\ndata: {}\n\n",
                body
            ))));
        }
        _ => {
            let body = json!({"error": { "message": msg, "type": "api_error", "code": code }});
            let _ = tx.blocking_send(Ok(bytes::Bytes::from(format!("data: {}\n\n", body))));
            let _ = tx.blocking_send(Ok(bytes::Bytes::from("data: [DONE]\n\n")));
        }
    }
}

fn internal_error_response() -> Response {
    Response::builder()
        .status(StatusCode::INTERNAL_SERVER_ERROR)
        .body(Body::from("{\"error\":{\"message\":\"internal error\"}}"))
        .unwrap_or_else(|_| Response::new(Body::empty()))
}

#[cfg(test)]
mod tests {
    use super::*;

    // ==================== 方案 C：双区定区口�?====================

    /// 定区三级优先�?+ 国际池开关回落：
    /// 模型前缀 > Key 绑区 > 默认区域；INTL 在开关关闭时回落 CN（与 dispatch 同口径）
    #[test]
    fn realm_pool_tag_priority_and_intl_switch() {
        use crate::tasks::qoder_realm::{pool_tag, CN, INTL};
        // 无显式前缀/绑定 �?默认区域（默�?CN，设置项 INTL 时取国际池）
        assert_eq!(realm_pool_tag_from(None, None, "", true), pool_tag(CN));
        assert_eq!(realm_pool_tag_from(None, None, "intl", true), pool_tag(INTL));
        assert_eq!(realm_pool_tag_from(None, None, "Global", true), pool_tag(INTL));
        // 模型前缀压过 Key 绑区与默认区域，且开关开启时生效
        assert_eq!(
            realm_pool_tag_from(Some(INTL), Some(CN), "cn", true),
            pool_tag(INTL)
        );
        assert_eq!(
            realm_pool_tag_from(Some(CN), Some(INTL), "intl", true),
            pool_tag(CN)
        );
        // Key 绑区压过默认区域
        assert_eq!(
            realm_pool_tag_from(None, Some(INTL), "cn", true),
            pool_tag(INTL)
        );
        // 国际版池关闭 �?国际区一律回落国内池（前缀/绑定/默认三条入口同规则）
        assert_eq!(realm_pool_tag_from(Some(INTL), None, "cn", false), pool_tag(CN));
        assert_eq!(realm_pool_tag_from(None, Some(INTL), "cn", false), pool_tag(CN));
        assert_eq!(realm_pool_tag_from(None, None, "intl", false), pool_tag(CN));
        // 国内区不受开关影�?        assert_eq!(realm_pool_tag_from(Some(CN), None, "intl", false), pool_tag(CN));
    }

    // ==================== issue #90 修复①：Server 渐进模型级冷�?====================

    /// 冷却表单测统一用的池标签（与真实池无关，只保证并行测试互不串键�?    const TP: &str = "qoder_test";

    /// Server 冷却按「失败片段」渐进（窗口过期才递增）且封顶；成功清除后归零�?    /// 冷却表是进程级共享静态，用独占模型名（前缀 + 计数器）避免并行测试互扰�?    #[test]
    fn server_cooldown_progressive_capped_and_cleared() {
        static SEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let model = format!(
            "t90-prog-{}",
            SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        );
        let key = cooldown_key(TP, &model);
        assert!(model_cooling_remaining_secs(TP, &model).is_none());
        // 片段 1：基�?30s
        note_model_server_cooldown(TP, &model);
        let r1 = model_cooling_remaining_secs(TP, &model).unwrap();
        assert!(r1 > 28 && r1 <= 30, "首次失败应为 30s 基准，实�?{r1}");
        // 同片段内连续记账（一次请求逐账号换号场景，窗口未过期）�?        // 不递增片段数，窗口仅延长（剩余�?�?0s，绝不翻倍）
        for _ in 0..4 {
            note_model_server_cooldown(TP, &model);
        }
        let (_, fails) = *cooldown_map()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .get(&key)
            .unwrap();
        assert_eq!(fails, 1, "窗口未过期时连续记账不得递增片段�?);
        // 人为推进到窗口过期（不真�?30s）：片段 2 �?翻�?60s
        cooldown_map()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .insert(key.clone(), (Instant::now() - Duration::from_secs(1), 1));
        note_model_server_cooldown(TP, &model);
        let r2 = model_cooling_remaining_secs(TP, &model).unwrap();
        assert!(r2 > 55 && r2 <= 60, "过期后新片段应翻倍至 60s，实�?{r2}");
        // 连续失败片段至封顶：窗口�?�?480s
        for _ in 0..10 {
            let cur = cooldown_map()
                .lock()
                .unwrap_or_else(|e| e.into_inner())
                .get(&key)
                .copied()
                .unwrap();
            cooldown_map()
                .lock()
                .unwrap_or_else(|e| e.into_inner())
                .insert(key.clone(), (Instant::now() - Duration::from_secs(1), cur.1));
            note_model_server_cooldown(TP, &model);
        }
        let capped = model_cooling_remaining_secs(TP, &model).unwrap();
        assert!(capped <= SERVER_COOLDOWN_MAX_SECS, "冷却窗口应封�?480s，实�?{capped}");
        // 成功清除 �?无冷却（片段计数随之归零�?        clear_model_cooldown(TP, &model);
        assert!(model_cooling_remaining_secs(TP, &model).is_none());
    }

    /// 排队退避（note_model_cooldown）不缩短既有 Server 冷却窗口：排队建议�?    /// （钳�?�?0s）到达时若并发请求刚记了更长�?Server 窗口，应取较大者�?    #[test]
    fn queued_cooldown_does_not_shorten_server_window() {
        static SEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let model = format!(
            "t90-queue-{}",
            SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        );
        // 两次 Server 失败（同一片段内）�?窗口维持基准 ~30s 不后�?        note_model_server_cooldown(TP, &model);
        note_model_server_cooldown(TP, &model);
        let before = model_cooling_remaining_secs(TP, &model).unwrap();
        // 排队退避建�?5s：不得把 60s 窗口缩短
        note_model_cooldown(TP, &model, 5);
        let after = model_cooling_remaining_secs(TP, &model).unwrap();
        assert!(
            after >= before.saturating_sub(1),
            "排队建议值不得缩短既�?Server 窗口（{before} �?{after}�?
        );
        clear_model_cooldown(TP, &model);
    }

    /// 回归：排队退避先插入 fails=0 条目（note_model_cooldown �?or_insert 路径），
    /// 随后 Server 失败进入 and_modify —�?fails=0 不得下溢（曾�?`*fails - 1`�?    /// debug panic / release 冷却被错误推�?480s），应保持基�?30s 且计数不�?    #[test]
    fn server_cooldown_after_queued_only_entry_no_underflow() {
        static SEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let model = format!(
            "t90-queue0-{}",
            SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        );
        // 排队退避先落条目：fails = 0
        note_model_cooldown(TP, &model, 5);
        // Server 失败：窗口未过期�?s 内）不递增计数，基�?30s 兜底
        note_model_server_cooldown(TP, &model);
        let r = model_cooling_remaining_secs(TP, &model).unwrap();
        assert!(r > 28 && r <= 30, "fails=0 时应�?30s 基准窗口，实�?{r}");
        let (_, fails) = *cooldown_map()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .get(&cooldown_key(TP, &model))
            .unwrap();
        assert_eq!(fails, 0, "窗口未过期不得递增失败计数");
        clear_model_cooldown(TP, &model);
    }

    /// 回归锁（根因：冷却表裸名做键）——同名模型在两区各自冷却，互不影响：
    /// 国内区挂上的排队窗口不得把国际区请求打成「qoder-intl/x cooling down」；
    /// 区前缀形态（`qoder-intl/x`）与裸名折叠为同一条目（清冷却不会漏清）�?    #[test]
    fn model_cooldown_is_region_scoped() {
        static SEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let model = format!(
            "t91-region-{}",
            SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        );
        note_model_cooldown("qoder_cn", &model, 60);
        assert!(
            model_cooling_remaining_secs("qoder_intl", &model).is_none(),
            "国内区冷却不得传染到国际�?
        );
        assert!(model_cooling_remaining_secs("qoder_cn", &model).is_some());
        // 区前缀与裸名同键：带前缀查询命中同一窗口
        let prefixed = format!("qoder-intl/{model}");
        note_model_cooldown("qoder_intl", &prefixed, 30);
        assert!(model_cooling_remaining_secs("qoder_intl", &model).is_some());
        // 清冷却对前缀形态同样生效（成功即清不留残条�?        clear_model_cooldown("qoder_intl", &model);
        assert!(model_cooling_remaining_secs("qoder_intl", &prefixed).is_none());
        clear_model_cooldown("qoder_cn", &model);
    }

    /// 冷却剩余秒数向上取整：剩余不�?1s 时不得报 0（旧实现 `as_secs()` 截断�?    /// 客户端按「retry after 0s」立即重试又会撞在窗口里），过期才返�?None
    #[test]
    fn cooling_remaining_rounds_up_and_expires() {
        static SEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let model = format!(
            "t91-ceil-{}",
            SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        );
        let key = cooldown_key(TP, &model);
        // 剩余 300ms：向上取�?= 1s（绝�?0�?        cooldown_map()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .insert(key.clone(), (Instant::now() + Duration::from_millis(300), 1));
        assert_eq!(model_cooling_remaining_secs(TP, &model), Some(1));
        // 已过�?�?None（残留条目按无冷却处理）
        cooldown_map()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .insert(key, (Instant::now() - Duration::from_millis(1), 1));
        assert!(model_cooling_remaining_secs(TP, &model).is_none());
    }

    /// issue #82 T2.3：credits 复数优先（新版字段），单�?credit 为旧版兜�?    #[test]
    fn extract_billing_prefers_plural_credits() {
        let u = json!({"credits": 12.5, "credit": 0, "original_credits": 25.0});
        let (c, o) = extract_billing(Some(&u));
        assert_eq!(c, Some(12.5));
        assert_eq!(o, Some(25.0));
        // 仅有旧版单数字段时兜底可读（新调用方 None 缺省不再走此路）
        let old = json!({"credit": 7});
        let (c, o) = extract_billing(Some(&old));
        assert_eq!(c, Some(7.0));
        assert_eq!(o, None);
    }

    /// issue #82 T2.3：双字段均缺 �?None（调用方不入账，不得伪�?0�?    #[test]
    fn extract_billing_missing_fields_yields_none() {
        assert_eq!(extract_billing(None), (None, None));
        let empty = json!({"prompt_tokens": 10, "completion_tokens": 5});
        assert_eq!(extract_billing(Some(&empty)), (None, None));
        let nulls = json!({"credits": null});
        assert_eq!(extract_billing(Some(&nulls)), (None, None));
    }

    /// issue #82 T2.3：负�?非有限值视为不可信，整体不入账
    #[test]
    fn extract_billing_rejects_negative() {
        let neg = json!({"credits": -3.0});
        assert_eq!(extract_billing(Some(&neg)), (None, None));
        let neg_pair = json!({"credits": 5.0, "original_credits": -1.0});
        let (c, o) = extract_billing(Some(&neg_pair));
        assert_eq!(c, Some(5.0));
        assert_eq!(o, None);
    }

    /// 会话 preview 剥离 system-reminder 注入块与 <user_input> 包裹标签�?    /// agent 客户端把提醒拼在正文前、输入用标签包裹，preview 必须取剥离后�?    /// 用户原话（多�?/ 跨行 / 前置残留空白）�?    #[test]
    fn session_preview_strips_system_reminder_blocks() {
        // 典型形态：多块 reminder 前置 + <user_input> 包裹的用户原�?        let peek = json!({"messages": [{"role": "user", "content":
            "<system-reminder>\nTodos have changed...\n# Todos\n- x\n</system-reminder>\n\n<system-reminder>The maximum number of terminals is 5</system-reminder>\n<user_input>\n说一�?00字笑话\n</user_input>"}]});
        assert_eq!(session_preview(&peek), "说一�?00字笑�?);

        // �?<user_input> 包裹、无 reminder
        let wrapped = json!({"messages": [{"role": "user", "content":
            "<user_input>写一�?00字笑�?/user_input>"}]});
        assert_eq!(session_preview(&wrapped), "写一�?00字笑�?);

        // 剥离后仅剩空�?�?空串（调用方按无 preview 处理，不展示注入内容�?        let only_reminder = json!({"messages": [{"role": "user", "content":
            "<system-reminder>纯注�?/system-reminder>"}]});
        assert_eq!(session_preview(&only_reminder), "");

        // �?reminder 的普通消息不受影响；末条 user 才是取值来�?        let plain = json!({"messages": [
            {"role": "user", "content": "第一�?},
            {"role": "assistant", "content": "回复"},
            {"role": "user", "content": "<system-reminder>x</system-reminder> 写一�?00字笑�?}
        ]});
        assert_eq!(session_preview(&plain), "写一�?00字笑�?);

        // reminder 之后再无正文 �?空；reminder 内含 "</system-reminder>" 字样也按整块匹配（非贪婪�?        let empty_tail = json!({"messages": [{"role": "user", "content":
            "前文<system-reminder>注入</system-reminder>  \n"}]});
        assert_eq!(session_preview(&empty_tail), "前文");
    }

    /// 远程目录测试条目（adopt_remote 接受的最小合法信封载荷）
    fn remote_entry(key: &str, display: &str, factor: f64) -> Value {
        json!({
            "key": key,
            "display_name": display,
            "enable": true,
            "is_vl": false,
            "is_reasoning": true,
            "price_factor": factor,
            "max_input_tokens": 128000,
            "source": "remote",
        })
    }

    /// G4 确定性判�?remote 态：注入独有前缀（TwaG4）的双区远程目录�?    /// 顺序覆盖 entry_is_global_only 的全部分支�?    /// adopt_remote 写进程级共享目录且远程非空时会替换静态兜底——必�?    /// �?catalog_test_guard 独占并在退出（�?panic）时自动复位回落兜底�?    /// 否则会污染并行运行的其他目录测试（如 qoder_upstream �?list 去重）�?    #[test]
    fn entry_is_global_only_remote_states() {
        let _catalog = qoder_upstream::catalog_test_guard();
        // �?CN 远程独有：list 标注 "cn"（Global 侧完全无�?id）→ 必非专属
        qoder_upstream::adopt_remote(
            qoder_upstream::QoderRegion::Cn,
            &json!({"statusCodeValue": 200,
                    "chat": [remote_entry("twa4cn_key", "TwaG4CnOnly", 0.5)]}),
        )
        .unwrap();
        let entry = qoder_upstream::resolve("TwaG4CnOnly", qoder_upstream::QoderRegion::Cn)
            .expect("CN 远程目录应命�?);
        assert!(!entry_is_global_only("TwaG4CnOnly", &entry));

        // �?Global 远程独有（CN 侧零可得证据）：两路 resolve 同落 Global 条目
        //    �?fail-closed 判专�?        qoder_upstream::adopt_remote(
            qoder_upstream::QoderRegion::Global,
            &json!({"statusCodeValue": 200,
                    "chat": [remote_entry("twa4g_key", "TwaG4GlobalOnly", 0.7)]}),
        )
        .unwrap();
        let entry =
            qoder_upstream::resolve("TwaG4GlobalOnly", qoder_upstream::QoderRegion::Cn)
                .expect("双区兜底应命�?Global 独有条目");
        assert!(entry_is_global_only("TwaG4GlobalOnly", &entry));

        // �?两区同名但声明不同（Global 倍率 0.7 / CN 倍率 0.3）：list 标注�?        //    Global 吞并�?"global"，但两路 resolve 命中不同条目 �?CN 远程
        //    确定可得 �?非专属（证据②，不再依赖值全等假设的反向推断�?        qoder_upstream::adopt_remote(
            qoder_upstream::QoderRegion::Global,
            &json!({"statusCodeValue": 200,
                    "chat": [remote_entry("twa4same_key", "TwaG4Same", 0.7)]}),
        )
        .unwrap();
        qoder_upstream::adopt_remote(
            qoder_upstream::QoderRegion::Cn,
            &json!({"statusCodeValue": 200,
                    "chat": [remote_entry("twa4same_key", "TwaG4Same", 0.3)]}),
        )
        .unwrap();
        let entry = qoder_upstream::resolve("TwaG4Same", qoder_upstream::QoderRegion::Cn)
            .expect("CN 远程目录应命�?);
        assert!(!entry_is_global_only("TwaG4Same", &entry));

        // �?两区同名且同值（旧「同名必异」假设被打破的场景）：确定性证据缺�?        //    �?策略性判专属（fail-closed，行为与旧版一致、依据改为显式策略）
        qoder_upstream::adopt_remote(
            qoder_upstream::QoderRegion::Global,
            &json!({"statusCodeValue": 200,
                    "chat": [remote_entry("twa4same_key", "TwaG4Same", 0.3)]}),
        )
        .unwrap();
        let entry = qoder_upstream::resolve("TwaG4Same", qoder_upstream::QoderRegion::Cn)
            .expect("CN 远程目录应命�?);
        assert!(entry_is_global_only("TwaG4Same", &entry));
    }
}

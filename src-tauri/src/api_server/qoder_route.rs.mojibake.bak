                    // M4锛氱紦瀛樿 tokens 鍚屾簮瀹藉彛寰勬彁鍙栵紝缁堟€佹梺璺璐︼紙0 鍊间笉鍏ヨ处锛?                    let cached = usage.as_ref().map(wb_sse::cached_tokens_of).unwrap_or(0);
                    let (credits, original_credits) = extract_billing(usage.as_ref());
                    // issue #111锛氬厤璐规。璋冨害锛堝厤璐规椿鍔ㄨ鐩栧紑鍚垨鐩綍浠?0锛夋秷鑰楁寜 0
                    // 钀借处鈥斺€斾笂娓?billable=false 瀹為檯涓嶆墸鍒嗭紝鍚嶄箟鍊肩収璁颁細铏氬鐢ㄩ噺
                    let (credits, original_credits) = if free_model {
                        (Some(0.0), Some(0.0))
                    } else {
                        (credits, original_credits)
                    };
                    // 瀹℃煡淇锛堜腑绛夐」锛夛細娴佸紡璁拌处瀵归綈闈炴祦寮忋€屾瘡璇锋眰涓€琛屻€嶅彛寰勨€斺€?                    // 涓嶅啀閫愬皾璇曡璐︼紙鍘熸瘡娆″皾璇曡涓€鏉★紝鎹㈠彿閲嶈瘯鑷?requests/errors
                    // 铏氶珮锛夛紱usage 浠呭湪璇锋眰缁堝眬锛堟垚鍔?灏卞湴鏀跺熬/鍐峰嵈缁堟/Fatal/鍙栧彿
                    // 鑰楀敖锛夊璁板綍锛屾崲鍙蜂腑闂存€侊紙break 缁х画杞崲锛変笉璁?                    match error_info {
                        Some((code, msg)) => {
                            // 娴佸唴閿欒鍒嗙被浠?ErrMeta 涓哄噯锛坱ranslate 鍐欏叆锛屽惈鎺掗槦/棰濆害淇″彿锛?                            match meta.as_ref().map(|m| m.kind) {
                                Some(UpstreamKind::Queued) => {
                                    // 鎺掗槦锛氬悓鍙烽€€閬块噸璇曚负涓伙紙瀵瑰啿鎺ョ鍚庝笉閫傜敤鈥斺€旈噸璇?                                    // 鍑瘉/璇锋眰浣撳睘涓昏处鍙凤紝涓庣敓鏁堣处鍙蜂笉涓€鑷达紝鐩存帴鎹㈠彿锛夛紱
                                    // 鑻ヨ妯″瀷宸茶骞跺彂璇锋眰璁板叆鍐峰嵈锛屽垯鐩存帴 break 鎹㈠彿
                                    //锛堝揩閫熷け璐ワ級
                                    if !sent_any && !hedge_taken && queue_same < QUEUE_RETRY_LIMIT {
                                        let secs = meta
                                            .as_ref()
                                            .and_then(|m| m.queue.as_ref())
                                            .and_then(|q| q.retry_after_secs)
                                            .unwrap_or(QUEUE_DEFAULT_BACKOFF_SECS)
                                            .clamp(1, QUEUE_BACKOFF_MAX_SECS);
                                        last_kind = Some(UpstreamKind::Queued);
                                        // 鎺掗槦鎬婚绠楋細瓒呴绠楃珛鍗虫敹灏撅紙429 + 閫€閬挎彁绀猴級锛?                                        // 涓嶅啀鎶婅姹傛嫋鍒板垎閽熺骇浠嶆棤杈撳嚭
                                        if queue_budget_exceeded(queue_waited_secs, secs) {
                                            let duration_ms =
                                                start_ts.elapsed().as_millis() as u64;
                                            state.record_usage_qoder(
                                                model, &win_uid, key_id, false, true,
                                                duration_ms, 0, 0, None, None, None,
                                                &session_ctx(&peek),
                                            );
                                            state.logger.log_request(
                                                "qoder", "POST", "/v1/chat/completions",
                                                model, true, 429, &win_uid, duration_ms,
                                                &key_name,
                                                &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                                Some("涓婃父鎺掗槦瓒呴绠楋紝鏀跺熬 429"),
                                            );
                                            send_stream_error(
                                                tx, proto, 429,
                                                &queue_budget_exhausted_msg(
                                                    model,
                                                    queue_waited_secs,
                                                    secs,
                                                ),
                                            );
                                            return;
                                        }
                                        // 瀹℃煡淇锛氭ā鍨嬬骇鍐峰嵈鈥斺€旀帓闃熸槸妯″瀷绾х幇璞★紝
                                        // 璁板綍绐楀彛渚?dispatch 棰勬蹇€熷洖閫€锛涘凡鍦ㄥ喎鍗?                                        // 涓紙骞跺彂璇锋眰鍒氳褰曡繃锛夋椂鎸?cooldown_gate 澶勭疆锛?                                        // 灏惧反鐫″畬鍐嶈瘯涓€娆★紝闀跨獥鍙ｆ墠缁堟杞崲杩斿洖 429锛?                                        // 涓嶅啀瀵规睜鍐呮瘡涓处鍙风‖鎵撳凡鐭ユ晠闅滀笂娓?                                        //锛堝師 break 鎹㈠彿浼氳疆鎹㈠埌鑰楀敖锛岄€愯处鍙风湡瀹炶姹傦級
                                        match cooldown_gate(pool_tag, model, Some(tx)) {
                                            // 灏惧反宸茬瓑瀹岋細鐩存帴閲嶈瘯鏈疆锛堜笉鍐嶉噸澶嶈绐楀彛/閫€閬匡級
                                            CooldownGate::Waited => {
                                                queue_same += 1;
                                                continue;
                                            }
                                            CooldownGate::None => {}
                                            CooldownGate::Hard(rem) => {
                                                let duration_ms =
                                                    start_ts.elapsed().as_millis() as u64;
                                                state.record_usage_qoder(
                                                    model, &win_uid, key_id, false, true,
                                                    duration_ms, 0, 0, None, None, None,
                                                    &session_ctx(&peek),
                                                );
                                                state.logger.log_request(
                                                    "qoder", "POST", "/v1/chat/completions",
                                                    model, true, 429, &win_uid, duration_ms,
                                                    &key_name,
                                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                                    Some("妯″瀷鍐峰嵈涓紝缁堟杞崲"),
                                                );
                                                send_stream_error(
                                                    tx, proto, 429,
                                                    &format!("model {model} cooling down, retry after {rem}s"),
                                                );
                                                return;
                                            }
                                            CooldownGate::Disconnected => {
                                                // 瀹℃煡 M5锛氭柇杩炰负璇锋眰缁堝眬锛岃ˉ璁板け璐ョ粓鎬佺敤閲?                                                state.record_usage_qoder(
                                                    model, &win_uid, key_id, false, true,
                                                    start_ts.elapsed().as_millis() as u64, 0, 0,
                                                    None, None, None, &session_ctx(&peek),
                                                );
                                                return;
                                            }
                                        }
                                        note_model_cooldown(pool_tag, model, secs);
                                        queue_same += 1;
                                        if !sleep_interruptible(Duration::from_secs(secs), Some(tx)) {
                                            // 瀹℃煡 M5锛氭柇杩炰负璇锋眰缁堝眬锛岃ˉ璁板け璐ョ粓鎬佺敤閲?                                            state.record_usage_qoder(
                                                model, &win_uid, key_id, false, true,
                                                start_ts.elapsed().as_millis() as u64, 0, 0,
                                                None, None, None, &session_ctx(&peek),
                                            );
                                            return; // 瀹㈡埛绔柇杩烇細鎻愬墠閫€鍑?                                        }
                                        queue_waited_secs = queue_waited_secs.saturating_add(secs);
                                        continue;
                                    }
                                    // 瓒呴檺/sent_any锛氫笉鍐?break 纭崲鍙封€斺€斿唴瀹瑰凡娴佸嚭
                                    // 锛坰ent_any=true锛夋椂鎹㈠彿閲嶅彂浼氬悜鍚屼竴 SSE 娴佹嫾鎺?                                    // 绗簩浠藉畬鏁村搷搴旓紱浜や笅鏂瑰叕鍏辨敹灏撅紙!sent_any鈫掓崲鍙凤紝
                                    // sent_any鈫掑氨鍦版敹灏撅級锛屼笌鍏朵粬閿欒鍒嗘敮鍙ｅ緞涓€鑷?                                }
                                Some(kind) => {
                                    last_kind = Some(kind);
                                    let ek = kind.to_err_kind();
                                    if ek != ErrKind::None {
                                        state.qoder_pool_for(pool_tag).note_error(&win_uid, ek);
                                        // issue #67锛氱‖鍐峰嵈/绂佺敤绫婚敊璇В缁戣璐﹀彿绮樻€?                                        if ek.unbinds_sticky() {
                                            state.qoder_sticky.unbind_uid(&win_uid);
                                        }
                                    }
                                    // issue #90 淇鈶狅細涓婃父鏈嶅姟绔紓甯革紙5xx/涓氬姟 504锛夌撼鍏?                                    // 妯″瀷绾ф笎杩涘喎鍗粹€斺€斾粎鍦ㄥ唴瀹规湭娴佸嚭鏃惰璐︼紙sent_any=true
                                    // 璇存槑妯″瀷瀹為檯鍦ㄦ湇鍔★紝灏鹃儴閿欒甯т笉浠ｈ〃妯″瀷鏁呴殰锛?                                    if kind == UpstreamKind::Server && !sent_any {
                                        note_model_server_cooldown(pool_tag, model);
                                    }
                                    // issue #90 淇鈶★細last_error 甯︽ā鍨嬪悕 + 鏃跺埢锛堟鍓嶅彧鏈?                                    // uid/code/msg锛屾棤娉曞畾浣嶆槸鍝釜妯″瀷銆佹晠闅滀粠浣曟椂寮€濮嬶級
                                    *safe_lock(&state.last_error) = Some(format!(
                                        "qoder uid={} model={} code={} msg={} at {}",
                                        win_uid,
                                        model,
                                        code,
                                        msg,
                                        now_cn_timestamp()
                                    ));
                                }
                                None => {
                                    // translate 涔嬪鐨勯敊璇抚銆侲OF 闆跺畬鎴愬摠鍏碉紙-9901锛変笉缁?                                    // translate 鍐?ErrMeta锛屽繀钀芥湰鍒嗘敮锛堥潪銆岀悊璁轰笉鍙揪銆嶏級锛?                                    // 涓婃父闂存瓏鎬х┖鍥炴斁灞炴殏鎬侊紝鎸?wb_route 鍙ｅ緞鍏嶇啍鏂紝
                                    // 浠呯敱涓嬫柟 !sent_any 鍒嗘敮鎹㈠彿閲嶈瘯
                                    if super::is_empty_completion(code, &msg) {
                                        empty_hits += 1; // 绌哄畬鎴愯鏁帮細鑰楀敖鏀跺熬鍖哄垎鎸囩汗鎷︽埅
                                    } else {
                                        state.qoder_pool_for(pool_tag).note_error(&win_uid, ErrKind::Server);

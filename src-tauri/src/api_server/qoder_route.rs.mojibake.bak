                                // 娴佸唴澶辫触宸插氨鍦伴€忎紶瀹㈡埛绔細涓嶉噸璇曚笉璁拌处鍐峰嵈锛堝悓 wb_route锛?                                state.logger.log_request_ttfb(
                                    "qoder", "POST", "/v1/chat/completions", model, true, 200,
                                    &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                    Some("娴佸唴澶辫触宸查€忎紶瀹㈡埛绔?),
                                );
                                return;
                            }
                            clear_model_cooldown(pool_tag, model); // 瀹℃煡淇锛氭垚鍔熷嵆娓呮ā鍨嬬骇鍐峰嵈
                            state.qoder_pool_for(pool_tag).note_success(&win_uid);
                            // 鎴愬姛缁堝眬锛氳 usage锛堝鏌ヤ慨澶嶁€斺€斿師閫愬皾璇曡璐﹀凡绉婚櫎锛?                            // 鎴愬姛琛屽湪姝ょ粺涓€钀借处锛夛紱M4锛氱紦瀛樿 tokens 鏃佽矾鍚岃惤
                            state.record_usage_cached(super::usage::UsageBucket::Qoder, cached);
                            state.record_usage_qoder(
                                model,
                                &win_uid,
                                key_id,
                                true,
                                true,
                                duration_ms,
                                pt,
                                ct,
                                Some(ttfb_ms),
                                credits,
                                original_credits,
                                &session_ctx_from_ids(&peek, win_session_ids.as_ref()),
                            );
                            // F-80-浣?v2锛氱粦瀹氱矘鎬т細璇濓紙寮€鍏冲紑鍚椂锛汳utex 鍐?re-check
                            // 闃?TOCTOU 鐢?StickyStore::bind 淇濊瘉锛?                            if state
                                .qoder_sticky_enabled
                                .load(std::sync::atomic::Ordering::Relaxed)
                            {
                                state.qoder_sticky.bind(&sticky_key, &win_uid, &sticky_seed, now_ts());
                                state.qoder_sticky.save(&state.data_dir);
                            }
                            state.logger.log_request_ttfb(
                                "qoder", "POST", "/v1/chat/completions", model, true, 200,
                                &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                &state.qoder_pool_for(pool_tag).name_of(&win_uid), None,
                            );
                            return;
                        }
                    }
                }
                Err((status, resp_body, retry_after)) => {
                    // HTTP 灞傚垎绾ч噸璇曪紙429/5xx/502 鍚屽彿閫€閬匡紱401/403/4xx 鎹㈠彿/缁堟锛?                    match retry_plan(status, &resp_body, same_attempt, retry_after) {
                        RetryAction::RetrySame { delay_ms } => {
                            same_attempt += 1;
                            // 瀹℃煡淇锛氬垎娈?sleep + 鏂繛鎰熺煡锛堝師鏁存 sleep 鏈€闀?60s锛?                            // 鏂繛鍚庝粛绌虹瓑锛涘師 sleep 鍚庣殑 is_closed 妫€鏌ヤ竴骞跺悎骞讹級
                            if !sleep_interruptible(
                                Duration::from_millis(delay_ms.min(60_000)),
                                Some(tx),
                            ) {
                                // 瀹℃煡 M5锛氭柇杩炰负璇锋眰缁堝眬锛岃ˉ璁板け璐ョ粓鎬佺敤閲?                                state.record_usage_qoder(
                                    model, &picked.uid, key_id, false, true,
                                    start_ts.elapsed().as_millis() as u64, 0, 0,
                                    None, None, None, &session_ctx(&peek),
                                );
                                return;
                            }
                            continue;
                        }
                        RetryAction::SwitchKey => {
                            // Qoder 涓氬姟閿欒甯稿湪 403/200 淇″皝閲岋細鎸?upstream 鍒嗙被锛?                            // 鎺掗槦锛?0605锛夊悓鍙烽€€閬夸紭鍏堚€斺€旀ā鍨嬪凡鍦ㄥ喎鍗翠腑鍒?                            // break 鎹㈠彿锛堝揩閫熷け璐ワ紝瑙佷笅鏂瑰喎鍗存鏌ワ級
                            let classified =
                                qoder_upstream::classify_upstream_error(status, &resp_body);
                            if classified.kind == UpstreamKind::Queued
                                && queue_same < QUEUE_RETRY_LIMIT
                            {
                                let secs = classified
                                    .queue
                                    .as_ref()
                                    .and_then(|q| q.retry_after_secs)
                                    .unwrap_or(QUEUE_DEFAULT_BACKOFF_SECS)
                                    .clamp(1, QUEUE_BACKOFF_MAX_SECS);
                                // 瀹℃煡淇锛氭ā鍨嬬骇鍐峰嵈锛堝悓娴佸唴 Queued 鍒嗘敮锛夆€斺€?                                // 灏惧反鐫″畬鍐嶈瘯銆侀暱绐楀彛鎵嶇粓姝㈣疆鎹㈣繑鍥?429
                                match cooldown_gate(pool_tag, model, Some(tx)) {
                                    CooldownGate::Waited => {
                                        queue_same += 1;
                                        continue;
                                    }
                                    CooldownGate::None => {}
                                    CooldownGate::Hard(rem) => {
                                        let duration_ms = start_ts.elapsed().as_millis() as u64;
                                        state.record_usage_qoder(
                                            model, &picked.uid, key_id, false, true,
                                            duration_ms, 0, 0, None, None, None,
                                            &session_ctx(&peek),
                                        );
                                        state.logger.log_request(
                                            "qoder", "POST", "/v1/chat/completions", model, true,
                                            429, &picked.uid, duration_ms, &key_name,
                                            &state.qoder_pool_for(pool_tag).name_of(&picked.uid),
                                            Some("妯″瀷鍐峰嵈涓紝缁堟杞崲"),
                                        );
                                        send_stream_error(
                                            tx, proto, 429,
                                            &format!("model {model} cooling down, retry after {rem}s"),
                                        );
                                        return;
                                    }
                                    CooldownGate::Disconnected => {
                                        // 瀹℃煡 M5锛氭柇杩炰负璇锋眰缁堝眬锛岃ˉ璁板け璐ョ粓鎬佺敤閲?                                        state.record_usage_qoder(
                                            model, &picked.uid, key_id, false, true,
                                            start_ts.elapsed().as_millis() as u64, 0, 0,
                                            None, None, None, &session_ctx(&peek),
                                        );
                                        return;
                                    }
                                }
                                note_model_cooldown(pool_tag, model, secs);
                                queue_same += 1;
                                if !sleep_interruptible(Duration::from_secs(secs), Some(tx)) {
                                    // 瀹℃煡 M5锛氭柇杩炰负璇锋眰缁堝眬锛岃ˉ璁板け璐ョ粓鎬佺敤閲?                                    state.record_usage_qoder(
                                        model, &picked.uid, key_id, false, true,
                                        start_ts.elapsed().as_millis() as u64, 0, 0,
                                        None, None, None, &session_ctx(&peek),
                                    );
                                    return; // 瀹㈡埛绔柇杩烇細鎻愬墠閫€鍑?                                }
                                continue;
                            }
                            let kind = classified.kind.to_err_kind();
                            if kind != ErrKind::None {
                                state.qoder_pool_for(pool_tag).note_error(&picked.uid, kind);
                                // issue #67锛氱‖鍐峰嵈/绂佺敤绫婚敊璇В缁戣璐﹀彿绮樻€?                                if kind.unbinds_sticky() {
                                    state.qoder_sticky.unbind_uid(&picked.uid);
                                }
                            }
                            // issue #90 淇鈶狅細HTTP 灞?5xx锛堝惈 504锛夋崲鍙峰墠璁版ā鍨嬬骇
                            // 娓愯繘鍐峰嵈鈥斺€斿惁鍒?504 鍙€愯处鍙疯疆鎹㈢‖鎵擄紝dispatch 棰勬
                            // 姘镐笉瑙﹀彂璺ㄦ睜鍥為€€锛坕ssue #90 涓昏瘔鍦烘櫙锛?                            if classified.kind == UpstreamKind::Server {
                                note_model_server_cooldown(pool_tag, model);
                            }
                            *safe_lock(&state.last_error) = Some(format!(
                                "qoder uid={} model={} status={} body={} at {}",
                                picked.uid,
                                model,
                                status,
                                safe_slice(&resp_body, 200),
                                now_cn_timestamp()
                            ));
                            state.logger.log_request(
                                "qoder", "POST", "/v1/chat/completions", model, true, status,
                                &picked.uid, start_ts.elapsed().as_millis() as u64, &key_name,
                                &state.qoder_pool_for(pool_tag).name_of(&picked.uid),
                                Some(&format!("upstream status={status}")),
                            );
                            break; // 鎹㈠彿
                        }
                        RetryAction::Fatal => {
                            let msg =
                                format!("upstream {} error: {}", status, safe_slice(&resp_body, 300));
                            // 缁堟€佽璐﹀榻愩€屾瘡璇锋眰涓€琛屻€嶅彛寰勶紙瀹℃煡 F3锛夛細Fatal 鏄姹?                            // 缁堝眬锛堝悓 no-healthy 鐢卞彇鍙峰垎鏀褰曪級锛屾鍓嶄粎 log_request
                            // 瀵艰嚧鐢ㄩ噺缁熻椤电己鍙ｏ紱ttfb/credits 鏃犲け璐ヨ涔変紶 None
                            state.record_usage_qoder(model, &picked.uid, key_id, false, true,
                                start_ts.elapsed().as_millis() as u64, 0, 0,
                                None, None, None, &session_ctx(&peek));
                            state.logger.log_request(
                                "qoder", "POST", "/v1/chat/completions", model, true, status,
                                &picked.uid, start_ts.elapsed().as_millis() as u64, &key_name,
                                &state.qoder_pool_for(pool_tag).name_of(&picked.uid), Some(&msg),
                            );
                            send_stream_error(tx, proto, status as i64, &msg);
                            return;
                        }
                    }
                }
            }
        }
    }
}

// ==================== 闈炴祦寮忥紙涓婃父鍙洖 SSE 鈫?鏈湴鑱氬悎锛?====================

/// Qoder 闈炴祦寮忓璇濓細鑱氬悎 + 鍗忚鎶曞奖锛坮outes.rs 鍚勫崗璁鐐硅皟鐢級
#[allow(clippy::too_many_arguments)]
pub async fn qoder_aggregate_chat(
    state: Arc<ApiSharedState>,
    body_vec: Vec<u8>,
    model: String,
    stream: bool,
    start_ts: Instant,
    proto: Protocol,
    key_id: String,
    guard: InflightGuard,
) -> Response {
    // 鏂规 C锛氬尯鍩熸睜閫夋嫨鈥斺€斾笌 dispatch 涓夌骇鍚屾簮锛堟ā鍨嬪墠缂€ > Key 缁戝尯 > 榛樿鍖哄煙锛夛紝
    // 鍖哄墠缂€鍙兘宸茶 dispatch 褰掍竴鍖栨秷璐癸紝鏁呭悓鏃惰璇锋眰浣撳師鍊?    let _bare_model = crate::tasks::qoder_realm::normalize_model_id(&model).1;
    // 璇锋眰浣撳師鍊硷細peek 鍦ㄩ棴鍖呭唴澶氬澶嶇敤锛屾澶勮В鏋愪竴娆″嵆鍙悓鏃朵緵瀹氬尯涓庢墽琛屼娇鐢?    let peek: Value = serde_json::from_slice(&body_vec).unwrap_or(json!({}));
    let body_model = peek.get("model").and_then(Value::as_str);
    let pool_tag = resolve_realm_pool_tag(
        &state,
        &model,
        body_model,
        format!("{key_id}").as_str(),
    );
    let model_out = model.clone();
    // 鑱氬悎鍚垎绾ч噸璇曪紙鍚屽彿閫€閬挎渶闀?60s脳N锛夛紝杩佸叆 stream_runtime 涓撶敤闃诲姹?    //锛堝悓 wb_aggregate_chat锛涢暱闃诲鍗犱富姹犱細楗挎閴存潈绛夌煭浠诲姟锛?    let result = super::stream_runtime().spawn_blocking(move || {
        let mut guard = guard;
        let key_name = super::api_keys::key_name_for(&state.data_dir, &key_id);

        // 鐩綍鎸夊尯瑙ｆ瀽锛坧ool_tag 鍐冲畾鍖哄煙锛夛紝鏈懡涓互 CN 鍖哄厹搴?        let Some(entry) = qoder_upstream::resolve(
        &_bare_model,
        crate::tasks::qoder_realm::region(pool_tag),
    )
    .or_else(|| qoder_upstream::resolve(&_bare_model, qoder_upstream::QoderRegion::Cn))
    else {
            // 瀹℃煡淇锛氳蛋 "upstream {status} error:" 鍙В鏋愰€氶亾鈥斺€旈潪娴佸紡閿欒
            // 瑙ｆ瀽鎸夊墠缂€鎻愬彇鐘舵€佺爜锛岃８娑堟伅姝ゅ墠钀?503锛屼笌娴佸紡 404 璇箟涓嶄竴鑷?            return Err(format!("upstream 404 error: model {model} not in Qoder catalog"));
        };
        // 鍖哄煙杈圭晫鎵ц鍏ュ彛妫€鏌ワ紙瀹℃煡淇锛夛細鍚?run_qoder_stream锛孏lobal 涓撳睘
        // 鏉＄洰鍦?*鍥藉唴鐗堟睜**鎵ц蹇呮锛屾槑纭嫆缁濊€岄潪閫忎紶涓婃父璇″紓鎶ラ敊锛涘浗闄呯増姹?        // 锛坧ool_tag == qoder_intl锛夋湰灏辨墦 Global 缃戝叧锛屽簲褰撴斁琛岋紙姝ゅ墠婕忔瀹堝崼锛?        // 鍥介檯鐗堜笓灞炴ā鍨嬭 404 鎷︽锛?        if pool_tag != "qoder_intl" && entry_is_global_only(&model, &entry) {
            return Err(format!(
                "upstream 404 error: model {model} only available in Qoder Global region, not yet supported"
            ));
        }
        let model_key = entry
            .get("upstreamKey")
            .and_then(Value::as_str)
            .unwrap_or("")
            .to_string();
        let model_source = entry
            .pointer("/config/source")
            .and_then(Value::as_str)
            .unwrap_or("system")
            .to_string();
        // issue #111锛氬厤璐规。妯″瀷锛堝€嶇巼 0锛夐浂娑堣€楋紝鍙栧彿璞佸厤绉垎缁村害杩囨护锛屽悓娴佸紡璺緞銆?        // 鍏嶈垂娲诲姩瑕嗙洊锛堣祫婧愯皟搴﹂〉寮€鍏筹級鍦ㄥ湴鍖轰笓灞炲垽瀹氫箣鍚庡簲鐢紙鍚屾祦寮忔敞閲婏級
        let entry = {
            let mut e = entry;
            qoder_upstream::apply_flash_free_override(
                &mut e,
                state
                    .qoder_flash_free_rate
                    .load(std::sync::atomic::Ordering::Relaxed),
            );
            e
        };
        let free_model = qoder_upstream::entry_is_free(&entry);

        let (allowed_set, dedicated) =
            super::api_keys::constraints_for(&state.data_dir, &key_id)
                .and_then(|k| k.pool_constraints("qoder"))
                .map_or((None, None), |c| (c.allowed, c.dedicated));

        // F-80-浣?v2 浼氳瘽绮樻€э紙鍚?run_qoder_stream锛涘紑鍏冲叧闂亽 None 淇濇寔 v1 琛屼负锛?        let sticky_key = SessionKey::from_body(&peek);
        let sticky0: Option<String> = if state
            .qoder_sticky_enabled
            .load(std::sync::atomic::Ordering::Relaxed)
        {
            state
                .qoder_sticky
                .resolve(&sticky_key, now_ts())
                .and_then(|b| {
                    if allowed_set.as_ref().is_some_and(|a| !a.contains(&b.uid)) {
                        return None;
                    }
                    state.qoder_pool_for(pool_tag).pick_by_uid(&b.uid, free_model).map(|_| b.uid)
                })
        } else {
            None
        };
        let sticky_seed: String = peek
            .get("session_id")
            .and_then(Value::as_str)
            .or_else(|| peek.get("user").and_then(Value::as_str))
            .unwrap_or("-")
            .to_string();
        // 棣栭€夛細绮樻€?> 璋冨害绛栫暐锛團-77鈶ｏ細绮樻€ц处鍙?busy 涓旀湁绌洪棽鍊欓€夋椂璁╀綅锛?        let mut first_pick: Option<super::pool::PickedAccount> = sticky0.as_ref().and_then(|u| {
            state
                .qoder_pool_for(pool_tag)
                .pick_sticky_yield(u, allowed_set.as_ref(), free_model)
                .map(|(p, ev)| {
                    if let Some(ev) = ev {
                        state.logger.log_sched_event(&ev);
                    }
                    p
                })
        });

        let mut tried: HashSet<String> = HashSet::new();
        let mut empty_hits: usize = 0; // 绌哄畬鎴愯鏁帮細杞崲鑰楀敖鏀跺熬鍖哄垎鎸囩汗鎷︽埅涓庤处鍙疯€楀敖
        // 鎺掗槦绱绛夊緟涓庢渶鍚庡け璐ュ垎绫伙紙涓庢祦寮忚矾寰勫悓鍙ｅ緞锛岃 QUEUE_WAIT_BUDGET_SECS锛?        let mut queue_waited_secs: u64 = 0;
        let mut last_kind: Option<UpstreamKind> = None;

        loop {
            // 鈹€鈹€ 鍙栧彿锛氱矘鎬у懡涓紭鍏堬紝鍚﹀垯鎸?Key 绾︽潫 + 璋冨害绛栫暐锛涙崲鍙峰悗浠呰蛋绛栫暐 鈹€鈹€
            let picked = match first_pick.take() {
                Some(p) => p,
                None => match state.qoder_pool_for(pool_tag).pick_excluding_constrained_ev(
                    &tried,
                    allowed_set.as_ref(),
                    dedicated.as_deref(),
                    free_model,
                ) {
                    Some((p, ev)) => {
                        if let Some(ev) = ev {
                            state.logger.log_sched_event(&ev);
                        }
                        p
                    }
                    None => {
                        state.record_usage_qoder(
                            &model,
                            "none",
                            &key_id,
                            false,
                            stream,
                            start_ts.elapsed().as_millis() as u64,
                            0,
                            0,
                            None,
                            None,
                            None,
                            &session_ctx(&peek),
                        );
                        // 瀹℃煡 P2锛氳疆鎹㈣€楀敖鏀跺熬瀵归綈 routes.rs鈥斺€旂┖瀹屾垚涓诲 鈫?鎸囩汗鎷︽埅璇箟
                        // 2026-10-19 瀹炴満淇锛氭湯娆″け璐ユ槸銆屼笂娓告帓闃熴€嶁啋 闄愭祦璇箟鏀跺熬锛?29
                        // 鍓嶇紑鐢辩鐐规槧灏勪负 429锛夛紝鑰屼笉鏄妸鍋ュ悍鐨勮处鍙锋姤鎴?no healthy account
                        if last_kind == Some(UpstreamKind::Queued) {
                            let msg =
                                queue_budget_exhausted_msg(&model, queue_waited_secs, QUEUE_DEFAULT_BACKOFF_SECS);
                            state.logger.log_debug_line(format!(
                                "[DEBUG] UPSTREAM_QUEUE_TIMEOUT tried={} waited={}s pool=qoder",
                                tried.len(),
                                queue_waited_secs,
                            ));
                            return Err(format!("upstream 429 error: {msg}"));
                        }
                        let (healthy_total, _) = state.qoder_pool_for(pool_tag).selectable_stats_in(None, free_model);
                        let (exhaust_msg, exhaust_tag) =
                            super::routes::exhaust_message(empty_hits, tried.len(), healthy_total);
                        // issue #99 鈶狅細褰卞瓙椋庢帶鏀跺熬钀藉師濮嬫寚绾规牱鏈紙闈炴祦寮忚矾寰勬棤鏀跺熬
                        // [DEBUG] 琛岋紝灏卞湴琛ラ綈锛涗笁姹犲悓鍙ｅ緞锛?                        if exhaust_tag == "CHANNEL_FINGERPRINT_BLOCK" {
                            state.logger.log_debug_line(format!(
                                "[DEBUG] {exhaust_tag} tried={} empty_hits={} pool=qoder 鎸囩汗鏍锋湰: {}",
                                tried.len(),
                                empty_hits,
                                super::wb_payload::fingerprint_sample(&body_vec),
                            ));
                        }
                        return Err(exhaust_msg);
                    }
                },
            };
            tried.insert(picked.uid.clone());
            // 褰撳墠璐﹀彿鎺掗槦閲嶈瘯璁℃暟锛堣处鍙峰眬閮細鎹㈠彿鑷劧閲嶇疆锛?            let mut queue_same: u32 = 0;
            // 瀹℃煡 P1-4 TOCTOU 鏀剁揣锛氭櫘閫氬€欓€?CAS 澶嶆牳銆屽湪閫?< 骞跺彂涓婇檺銆嶏紝宸叉弧鍒?            // 涓嶅彂璧疯姹傛崲涓嬩竴鍊欓€夛紙涓嶈閿欒涓嶅喎鍗达級锛沷ver_limit 鍊欓€夛紙绮樻€ч攣瀹氥€?            // busy_fallback 闄嶇骇锛変繚鐣欏師鏃犳潯浠剁粦瀹氳涔夈€?            // active_uid 浠呭湪缁戝畾鎴愬姛鍚庢洿鏂帮紙CAS 鎷掔粷鐨勫€欓€変笉寰楁薄鏌撱€屽綋鍓嶈处鍙枫€嶅睍绀猴級
            let bound = if picked.over_limit {
                guard = guard.bind_account(state.qoder_pool_for(pool_tag).inflight_handle(&picked.uid));
                true
            } else {
                guard.bind_account_cas(
                    state.qoder_pool_for(pool_tag).inflight_handle(&picked.uid),
                    state.qoder_pool_for(pool_tag).concurrency_limit(),
                )
            };
            if !bound {
                continue;
            }
            *safe_lock(&state.active_uid) = Some(picked.uid.clone());

            let creds: QoderCreds = match state.qoder_identity.as_ref() {
                None => continue, // 鍥炶皟鏈敞鍏ワ細鎹㈠彿锛坱ried 澧為暱鑷劧鑰楀敖鍚?503锛?                Some(resolve) => match resolve(&picked.uid) {
                    Ok(c) => c,
                    Err(e) => {
                        // 瀹℃煡淇锛氱灛鏃跺け璐ヨ蛋 Server 鐔旀柇鍙嚜鎰堬紙鍚屾祦寮忚矾寰勶級
                        let kind = if crate::tasks::qoder_common::is_transient_identity_err(&e) {
                            ErrKind::Server
                        } else {
                            ErrKind::SessionDead
                        };
                        state.qoder_pool_for(pool_tag).note_error(&picked.uid, kind);
                        // issue #67锛氱‖鍐峰嵈/绂佺敤绫婚敊璇В缁戣璐﹀彿绮樻€?                        if kind.unbinds_sticky() {
                            state.qoder_sticky.unbind_uid(&picked.uid);
                        }
                        *safe_lock(&state.last_error) = Some(format!(
                            // 瀹℃煡淇锛氬悓娴佸紡鍒嗘敮锛宔rr 鍘熸枃鎴柇鑴辨晱
                            "qoder identity uid={} err={}",
                            picked.uid,
                            safe_slice(&e, 200)
                        ));
                        continue;
                    }
                },
            };

            let converted = match qoder_upstream::prepare_qoder_body(&peek, &entry, &creds.uid) {
                Ok(b) => b,
                Err(e) => return Err(e),
            };
            // 瀹℃煡淇 K锛氫俊灏?id 鍦ㄥ灞傝В鏋愪竴娆★紝鍐呭眰璁拌处澶嶇敤锛堝悓娴佸紡璺緞锛?            let envelope_ids = extract_envelope_ids(&converted);

            let mut same_attempt: u32 = 0;
            // 瀵瑰啿鎺ョ鏍囪锛氭帴绠″悗鎺掗槦鍚屽彿閫€閬夸笉閫傜敤锛堥噸璇曞嚟璇?璇锋眰浣撳睘涓昏处鍙凤級
            #[allow(unused_assignments)]
            let mut hedge_taken = false;
            loop {
                // F-76鈶?TTFT 閲囨牱锛堝悓 wb_route 鑱氬悎锛氬悇杞嫭绔嬭鏃讹紝鏈€缁堣疆鍗虫渶缁堝洖澶?TTFT锛?                let ttfb_start = Instant::now();
                match qoder_upstream::make_qoder_request(
                    &creds,
                    &converted,
                    &model_key,
                    &model_source,
                ) {
                    Ok(reader) => {
                        let err_slot: Arc<Mutex<Option<ErrMeta>>> = Arc::new(Mutex::new(None));
                        // 棣栧瓧瓒呮椂 10s + F-80-浣?v2 绔為€熷鍐诧紙瀵瑰啿鍏抽棴鏃朵笌绾瀛?                        // 瓒呮椂璇箟涓€鑷达級锛氳秴鏃?鍙岃触瑙嗕负涓婃父鏁呴殰 鈫?鎹㈠彿
                        let mut race = match race_qoder_first_byte(
                            &state,
                            pool_tag,
                            &picked.uid,
                            reader,
                            &peek,
                            &entry,
                            &model_key,
                            &model_source,
                            &tried,
                            allowed_set.as_ref(),
                            dedicated.as_deref(),
                            &envelope_ids,
                        ) {
                            Ok(w) => w,
                            Err(()) => {
                                state.qoder_pool_for(pool_tag).note_error(&picked.uid, ErrKind::Server);
                                break;
                            }
                        };
                        let ttfb_ms = ttfb_start.elapsed().as_millis() as u64;
                        // 瀵瑰啿璁℃暟钀藉畾 + guard 閲嶇粦锛堟帴绠℃椂鐢熸晥璐﹀彿 = 瀵瑰啿璐﹀彿锛?                        guard = settle_qoder_hedge(&state, &mut race, guard, &picked.uid);
                        hedge_taken = race.takeover;
                        let win_uid = race.uid.clone();
                        // G4锛氳璐︿細璇?id 鎸夎儨鑰呬俊灏佽惤瀹氾紙race 鍦ㄨ仛鍚堝琚儴鍒嗘秷璐癸紝鍏堝彇蹇収锛?                        let win_session_ids = race.session_ids.clone().or_else(|| envelope_ids.clone());
                        // 绔為€熻儨鑰呭師濮嬭婧?鈫?缈昏瘧 鈫?鑱氬悎锛坱ool_calls 鍚堝苟/usage 鏀堕泦锛夛紱
                        // 棣栧瓧瓒呮椂宸插湪 race 鍐呰瀹氾紝鑱氬悎闃舵鏃犲け璐ラ€氶亾
                        let agg_chat_id = format!("chatcmpl-{}", now_ts());
                        let translated =
                            qoder_upstream::QoderTranslate::new(race.lines, err_slot.clone(), &agg_chat_id, &model);
                        let (resp, error) = wb_sse::aggregate(translated, &agg_chat_id);
                        let duration_ms = start_ts.elapsed().as_millis() as u64;
                        match (resp, error) {
                            (Some(mut r), None) => {
                                r["model"] = json!(model);
                                // M1 淇锛堝鏌ワ級锛歛s_u64 绐勫彛寰勬敼 wb_sse::u64_pair
                                // 瀹藉彛寰勶紙瀛楃涓?娴偣褰㈡€佷笉鍐嶉潤榛樺緱 0锛?                                let (pt, ct) = r.get("usage").map(wb_sse::u64_pair).unwrap_or((0, 0));
                                let (credits, original_credits) =
                                    extract_billing(r.get("usage"));
                                // issue #111锛氬厤璐规。璋冨害娑堣€楁寜 0 钀借处锛堝悓娴佸紡璺緞娉ㄩ噴锛?                                let (credits, original_credits) = if free_model {
                                    (Some(0.0), Some(0.0))
                                } else {
                                    (credits, original_credits)
                                };
                                // M4锛氱紦瀛樿 tokens 鏃佽矾璁拌处锛堟垚鍔熺粓灞€锛? 鍊间笉鍏ヨ处锛?                                state.record_usage_cached(
                                    super::usage::UsageBucket::Qoder,
                                    r.get("usage").map(wb_sse::cached_tokens_of).unwrap_or(0),
                                );
                                state.record_usage_qoder(
                                    &model, &win_uid, &key_id, true, stream, duration_ms, pt, ct,
                                    Some(ttfb_ms),
                                    credits,
                                    original_credits,
                                    &session_ctx_from_ids(&peek, win_session_ids.as_ref()),
                                );
                                clear_model_cooldown(pool_tag, &model); // 瀹℃煡淇锛氭垚鍔熷嵆娓呮ā鍨嬬骇鍐峰嵈
                                state.qoder_pool_for(pool_tag).note_success(&win_uid);
                                // F-80-浣?v2锛氱粦瀹氱矘鎬т細璇濓紙寮€鍏冲紑鍚椂锛涘悓娴佸紡璺緞锛?                                if state
                                    .qoder_sticky_enabled
                                    .load(std::sync::atomic::Ordering::Relaxed)
                                {
                                    state.qoder_sticky.bind(&sticky_key, &win_uid, &sticky_seed, now_ts());
                                    state.qoder_sticky.save(&state.data_dir);
                                }
                                state.logger.log_request_ttfb(
                                    "qoder", "POST", "/v1/chat/completions", &model, stream, 200,
                                    &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid), None,
                                );
                                return Ok(r);
                            }
                            (None, Some((code, msg))) => {
                                let meta = err_slot
                                    .lock()
                                    .unwrap_or_else(|e| e.into_inner())
                                    .clone();
                                match meta.as_ref().map(|m| m.kind) {
                                    Some(UpstreamKind::Queued) => {
                                        // 鎺掗槦锛氬悓鍙烽€€閬块噸璇曚负涓伙紙瀵瑰啿鎺ョ鍚庝笉閫傜敤锛?                                        // 鍚屾祦寮忚矾寰勨€斺€旂洿鎺ユ崲鍙凤級锛涙ā鍨嬪凡鍦ㄥ喎鍗翠腑
                                        // 鍒?break 鎹㈠彿锛堝揩閫熷け璐ワ紝瑙佷笅鏂瑰喎鍗存鏌ワ級
                                        if !hedge_taken && queue_same < QUEUE_RETRY_LIMIT {
                                            let secs = meta
                                                .as_ref()
                                                .and_then(|m| m.queue.as_ref())
                                                .and_then(|q| q.retry_after_secs)
                                                .unwrap_or(QUEUE_DEFAULT_BACKOFF_SECS)
                                                .clamp(1, QUEUE_BACKOFF_MAX_SECS);
                                            last_kind = Some(UpstreamKind::Queued);
                                            // 鎺掗槦鎬婚绠楋細瓒呴绠楀嵆鏀跺熬锛?29 鍓嶇紑鐢辩鐐?                                            // 鏄犲皠涓?429锛夛紝涓嶅啀鎶婅姹傛嫋鍒板垎閽熺骇
                                            if queue_budget_exceeded(queue_waited_secs, secs) {
                                                state.record_usage_qoder(
                                                    &model, &win_uid, &key_id, false, stream,
                                                    duration_ms, 0, 0, None, None, None,
                                                    &session_ctx(&peek),
                                                );
                                                let msg = queue_budget_exhausted_msg(
                                                    &model,
                                                    queue_waited_secs,
                                                    secs,
                                                );
                                                state.logger.log_request_ttfb(
                                                    "qoder", "POST", "/v1/chat/completions",
                                                    &model, stream, 429, &win_uid, duration_ms,
                                                    Some(ttfb_ms), &key_name,
                                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                                    Some("涓婃父鎺掗槦瓒呴绠楋紝鏀跺熬 429"),
                                                );
                                                return Err(format!("upstream 429 error: {msg}"));
                                            }
                                            // 瀹℃煡淇锛氭ā鍨嬬骇鍐峰嵈锛堝悓娴佸紡鍒嗘敮锛夆€斺€?                                            // 鍐峰嵈涓洿鎺ョ粓姝㈣疆鎹㈣繑鍥?429锛坲pstream
                                            // 鍓嶇紑鍊熷姪绔偣鐘舵€佺爜閫忎紶鏄犲皠锛夛紝涓嶅啀閫愯处鍙风‖鎵?                                            match cooldown_gate(pool_tag, &model, None) {
                                                CooldownGate::Waited => {
                                                    queue_same += 1;
                                                    continue;
                                                }
                                                CooldownGate::None => {}
                                                CooldownGate::Hard(rem) => {
                                                    state.record_usage_qoder(
                                                        &model, &win_uid, &key_id, false, stream,
                                                        duration_ms, 0, 0, None, None, None,
                                                        &session_ctx(&peek),
                                                    );
                                                    state.logger.log_request_ttfb(
                                                        "qoder", "POST", "/v1/chat/completions",
                                                        &model, stream, 429, &win_uid, duration_ms,
                                                        Some(ttfb_ms), &key_name,
                                                        &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                                        Some("妯″瀷鍐峰嵈涓紝缁堟杞崲"),
                                                    );
                                                    return Err(format!(
                                                        "upstream 429 error: model {model} cooling down, retry after {rem}s"
                                                    ));
                                                }
                                                // 闈炴祦寮忔棤涓嬭閫氶亾锛坱x=None锛夆啋 涓嶄細鏂繛
                                                CooldownGate::Disconnected => {}
                                            }
                                            note_model_cooldown(pool_tag, &model, secs);
                                            queue_same += 1;
                                            // 缁熶竴璧?sleep_interruptible(None)锛氬垎娈电瓑寰咃紝
                                            // 涓庢祦寮忓疄鐜板彛寰勪竴鑷达紙闈炴祦寮忔棤涓嬭閫氶亾浼?None锛?                                            // 璇箟绛夊悓鏁存 sleep锛屼粎灏佽缁熶竴锛?                                            sleep_interruptible(Duration::from_secs(secs), None);
                                            queue_waited_secs = queue_waited_secs.saturating_add(secs);
                                            continue;
                                        }
                                        break; // 瓒呴檺鎹㈠彿
                                    }
                                    Some(kind) => {
                                        last_kind = Some(kind);
                                        let ek = kind.to_err_kind();
                                        if ek != ErrKind::None {
                                            state.qoder_pool_for(pool_tag).note_error(&win_uid, ek);
                                            // issue #67 瀹℃煡淇锛氳处鍙风骇闀垮喎鍗磋В缁戠矘鎬э紙涓庢祦寮忓垎鏀彛寰勫榻愶級
                                            if ek.unbinds_sticky() {
                                                state.qoder_sticky.unbind_uid(&win_uid);
                                            }
                                        }
                                        // issue #90 淇鈶狅細鍚屾祦寮忓垎鏀紙闈炴祦寮忔棤閮ㄥ垎娴佸嚭姒傚康锛?                                        if kind == UpstreamKind::Server {
                                            note_model_server_cooldown(pool_tag, &model);
                                        }
                                    }
                                    None => {
                                        state.qoder_pool_for(pool_tag).note_error(&win_uid, ErrKind::Server);
                                    }
                                }
                                *safe_lock(&state.last_error) = Some(format!(
                                    "qoder uid={} model={} code={} msg={} at {}",
                                    win_uid,
                                    model,
                                    code,
                                    msg,
                                    now_cn_timestamp()
                                ));
                                state.logger.log_request_ttfb(
                                    "qoder", "POST", "/v1/chat/completions", &model, stream, 200,
                                    &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid), Some(&msg),
                                );
                                // 娴佸唴閿欒涓旀湭浜у嚭鍐呭 鈫?鎹㈠彿閲嶈瘯
                                break;
                            }
                            _ => {
                                // (None, None)锛欵OF 闆跺畬鎴愶紙褰卞瓙椋庢帶/涓婃父寮傚父锛夆€斺€旇鏁板悗鎹㈠彿
                                empty_hits += 1;
                                state.qoder_pool_for(pool_tag).note_error(&win_uid, ErrKind::Server);
                                state.logger.log_request_ttfb(
                                    "qoder", "POST", "/v1/chat/completions", &model, stream, 502,
                                    &win_uid, duration_ms, Some(ttfb_ms), &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&win_uid),
                                    Some("empty response"),
                                );
                                break;
                            }
                        }
                    }
                    Err((status, resp_body, retry_after)) => {
                        match retry_plan(status, &resp_body, same_attempt, retry_after) {
                            RetryAction::RetrySame { delay_ms } => {
                                same_attempt += 1;
                                sleep_interruptible(
                                    Duration::from_millis(delay_ms.min(60_000)),
                                    None,
                                );
                                continue;
                            }
                            RetryAction::SwitchKey => {
                                let classified =
                                    qoder_upstream::classify_upstream_error(status, &resp_body);
                                if classified.kind == UpstreamKind::Queued
                                    && queue_same < QUEUE_RETRY_LIMIT
                                {
                                    let secs = classified
                                        .queue
                                        .as_ref()
                                        .and_then(|q| q.retry_after_secs)
                                        .unwrap_or(QUEUE_DEFAULT_BACKOFF_SECS)
                                        .clamp(1, QUEUE_BACKOFF_MAX_SECS);
                                    // 瀹℃煡淇锛氭ā鍨嬬骇鍐峰嵈锛堝悓娴佸紡鍒嗘敮锛夆€斺€斿喎鍗翠腑
                                    // 鐩存帴缁堟杞崲杩斿洖 429锛屼笉鍐嶉€愯处鍙风‖鎵?                                    match cooldown_gate(pool_tag, &model, None) {
                                        CooldownGate::Waited => {
                                            queue_same += 1;
                                            continue;
                                        }
                                        CooldownGate::None => {}
                                        CooldownGate::Hard(rem) => {
                                            state.record_usage_qoder(&model, &picked.uid, &key_id,
                                                false, stream,
                                                start_ts.elapsed().as_millis() as u64, 0, 0,
                                                None, None, None, &session_ctx(&peek));
                                            state.logger.log_request(
                                                "qoder", "POST", "/v1/chat/completions", &model,
                                                stream, 429, &picked.uid,
                                                start_ts.elapsed().as_millis() as u64, &key_name,
                                                &state.qoder_pool_for(pool_tag).name_of(&picked.uid),
                                                Some("妯″瀷鍐峰嵈涓紝缁堟杞崲"),
                                            );
                                            return Err(format!(
                                                "upstream 429 error: model {model} cooling down, retry after {rem}s"
                                            ));
                                        }
                                        // 闈炴祦寮忔棤涓嬭閫氶亾锛坱x=None锛夆啋 涓嶄細鏂繛
                                        CooldownGate::Disconnected => {}
                                    }
                                    note_model_cooldown(pool_tag, &model, secs);
                                    queue_same += 1;
                                    // 瀹℃煡 Low锛氬榻愬悓鍑芥暟鍏朵綑闈炴祦寮忛€€閬跨偣锛岀粺涓€璧?                                    // sleep_interruptible(None)锛堝垎娈电瓑寰咃紝闈炴祦寮忔棤
                                    // 涓嬭閫氶亾浼?None锛岃涔夌瓑鍚屾暣娈?sleep锛屼粎灏佽缁熶竴锛?                                    sleep_interruptible(Duration::from_secs(secs), None);
                                    continue;
                                }
                                let kind = classified.kind.to_err_kind();
                                if kind != ErrKind::None {
                                    state.qoder_pool_for(pool_tag).note_error(&picked.uid, kind);
                                    // issue #67锛氱‖鍐峰嵈/绂佺敤绫婚敊璇В缁戣璐﹀彿绮樻€?                                    if kind.unbinds_sticky() {
                                        state.qoder_sticky.unbind_uid(&picked.uid);
                                    }
                                }
                                // issue #90 淇鈶狅細鍚屾祦寮?HTTP 鍒嗘敮锛?xx 鎹㈠彿鍓嶈妯″瀷绾у喎鍗达級
                                if classified.kind == UpstreamKind::Server {
                                    note_model_server_cooldown(pool_tag, &model);
                                }
                                *safe_lock(&state.last_error) = Some(format!(
                                    "qoder uid={} model={} status={} body={} at {}",
                                    picked.uid,
                                    model,
                                    status,
                                    safe_slice(&resp_body, 200),
                                    now_cn_timestamp()
                                ));
                                // 璁拌处鍙ｅ緞瀵归綈娴佸紡璺緞锛堟瘡璇锋眰涓€琛岋級锛氭崲鍙蜂腑闂存€佷笉璁?                                // usage锛堝師鑱氬悎璺緞姣忔鎹㈠彿澶氳涓€鏉″け璐ワ紝qoder 妗?                                // requests/errors 铏氶珮锛夛紱鏈€缁?no-healthy 鐢卞彇鍙峰垎鏀褰?                                state.logger.log_request(
                                    "qoder", "POST", "/v1/chat/completions", &model, stream,
                                    status, &picked.uid,
                                    start_ts.elapsed().as_millis() as u64, &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&picked.uid),
                                    Some(&format!("upstream status={status}")),
                                );
                                break;
                            }
                            RetryAction::Fatal => {
                                // 缁堟€佽璐﹀榻愩€屾瘡璇锋眰涓€琛屻€嶅彛寰勶紙瀹℃煡 F3锛夛細Fatal 鏄?                                // 璇锋眰缁堝眬锛堝悓 no-healthy 鐢卞彇鍙峰垎鏀褰曪級锛屾鍓嶄粎
                                // log_request 瀵艰嚧鐢ㄩ噺缁熻椤电己鍙?                                state.record_usage_qoder(&model, &picked.uid, &key_id, false, stream,
                                    start_ts.elapsed().as_millis() as u64, 0, 0,
                                    None, None, None, &session_ctx(&peek));
                                state.logger.log_request(
                                    "qoder", "POST", "/v1/chat/completions", &model, stream,
                                    status, &picked.uid,
                                    start_ts.elapsed().as_millis() as u64, &key_name,
                                    &state.qoder_pool_for(pool_tag).name_of(&picked.uid),
                                    Some(&safe_slice(&resp_body, 300)),
                                );
                                return Err(format!(
                                    "upstream {} error: {}",
                                    status,
                                    safe_slice(&resp_body, 300)
                                ));
                            }
                        }
                    }
                }
            }
        }
    })
    .await;

    match result {
        Ok(Ok(resp)) => {
            let body = match proto {
                Protocol::Anthropic => wb_sse::completion_to_anthropic(
                    &resp,
                    &format!("msg_{}", now_ts()),
                    &model_out,
                ),
                Protocol::OpenAiText => wb_sse::completion_to_text(&resp, &model_out),
                Protocol::Responses => super::wb_responses::completion_to_responses(
                    &resp,
                    &format!("resp_{}", now_ts()),
                    &model_out,
                    // Qoder 鏃?namespace 灞曞钩缂栫爜锛圧esponses 鍒嗘敮涓洪槻寰℃€у厹搴曪級
                    &std::collections::HashSet::new(),
                ),
                Protocol::OpenAi => resp,
            };
            Response::builder()
                .header("content-type", "application/json")
                .body(Body::from(body.to_string()))
                .unwrap_or_else(|_| internal_error_response())
        }
        Ok(Err(msg)) => {
            // 瀹℃煡淇锛堝榻?wb_aggregate_chat锛夛細Fatal 閿欒閫忎紶涓婃父鐘舵€佺爜鈥斺€?            // 涓婃父 400/404/413 绛夎姹傜骇閿欒涓嶉檷绾?503锛岄伩鍏嶄弗鏍煎鎴风鏃犳剰涔夐噸璇曪紱
            // 401/403 缁存寔 503 璇箟锛?29 涓烘ā鍨嬪喎鍗翠富鍔ㄩ檺娴侊紙瀹℃煡涓瓑椤癸級锛岄€忎紶
            // 璁╁鎴风鎸?Retry-After 璇箟閫€閬胯€岄潪绔嬪嵆閲嶈瘯
            let upstream_status = msg
                .strip_prefix("upstream ")
                .and_then(|rest| rest.split(' ').next())
                .and_then(|s| s.parse::<u16>().ok());
            let status = match upstream_status {
                Some(s) if (400..500).contains(&s) && !matches!(s, 401 | 403) => {
                    StatusCode::from_u16(s).unwrap_or(StatusCode::SERVICE_UNAVAILABLE)
                }
                _ => StatusCode::SERVICE_UNAVAILABLE,
            };
            let resp = match proto {
                Protocol::Anthropic => anthropic_error(status, "api_error", &msg),
                _ => openai_error(status, "upstream_error", &msg),
            };
            // 429 鐨勫喎鍗村墿浣欑鏁板彧鍦ㄦ枃妗堥噷锛圗rr(String) 鏃犵粨鏋勯€氶亾锛夆€斺€斿洖鏀跺悗琛ユ垚
            // Retry-After 澶达紝瀹㈡埛绔墠鎸夈€岃繕鍓╁嚑绉掋€嶉€€閬胯€屼笉鏄嚜宸辩寽
            match (status, super::routes::retry_after_in_msg(&msg)) {
                (StatusCode::TOO_MANY_REQUESTS, Some(secs)) => {
                    super::routes::with_retry_after(resp, secs)
                }
                _ => resp,
            }
        }
        Err(e) => openai_error(
            StatusCode::INTERNAL_SERVER_ERROR,
            "internal_error",
            &format!("task join error: {}", e),
        ),
    }
}

// ==================== 灏忓伐鍏?====================

fn now_ts() -> i64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.as_secs() as i64)
        .unwrap_or(0)
}

/// 娴佸唴閿欒甯т笅鍙戯紙鑷妱 send_stream_error_wb锛氱鏈変笉鍙鐢紱褰㈡€佸悓鏋勶級
fn send_stream_error(
    tx: &tokio::sync::mpsc::Sender<Result<bytes::Bytes, std::io::Error>>,
    proto: Protocol,
    code: i64,
    msg: &str,
) {
    let msg = stream_msg_or_fallback(msg, code);
    match proto {
        Protocol::Anthropic => {
            let err = json!({"type":"error","error":{"type":"api_error","message":msg}});
            let _ = tx.blocking_send(Ok(bytes::Bytes::from(format!(
                "event: error\ndata: {}\n\n",
                err
            ))));
        }
        Protocol::Responses => {
            let resp = json!({
                "id": format!("resp_{}", now_ts()),
                "object": "response",
                "status": "failed",
                "output": [],
                "error": {"code": code.to_string(), "message": msg},
            });
            let body = json!({"type": "response.failed", "response": resp});
            let _ = tx.blocking_send(Ok(bytes::Bytes::from(format!(
                "event: response.failed\ndata: {}\n\n",
                body
            ))));
        }
        _ => {
            let body = json!({"error": { "message": msg, "type": "api_error", "code": code }});
            let _ = tx.blocking_send(Ok(bytes::Bytes::from(format!("data: {}\n\n", body))));
            let _ = tx.blocking_send(Ok(bytes::Bytes::from("data: [DONE]\n\n")));
        }
    }
}

fn internal_error_response() -> Response {
    Response::builder()
        .status(StatusCode::INTERNAL_SERVER_ERROR)
        .body(Body::from("{\"error\":{\"message\":\"internal error\"}}"))
        .unwrap_or_else(|_| Response::new(Body::empty()))
}

#[cfg(test)]
mod tests {
    use super::*;

    // ==================== 鏂规 C锛氬弻鍖哄畾鍖哄彛寰?====================

    /// 瀹氬尯涓夌骇浼樺厛绾?+ 鍥介檯姹犲紑鍏冲洖钀斤細
    /// 妯″瀷鍓嶇紑 > Key 缁戝尯 > 榛樿鍖哄煙锛汭NTL 鍦ㄥ紑鍏冲叧闂椂鍥炶惤 CN锛堜笌 dispatch 鍚屽彛寰勶級
    #[test]
    fn realm_pool_tag_priority_and_intl_switch() {
        use crate::tasks::qoder_realm::{pool_tag, CN, INTL};
        // 鏃犳樉寮忓墠缂€/缁戝畾 鈫?榛樿鍖哄煙锛堥粯璁?CN锛岃缃」 INTL 鏃跺彇鍥介檯姹狅級
        assert_eq!(realm_pool_tag_from(None, None, "", true), pool_tag(CN));
        assert_eq!(realm_pool_tag_from(None, None, "intl", true), pool_tag(INTL));
        assert_eq!(realm_pool_tag_from(None, None, "Global", true), pool_tag(INTL));
        // 妯″瀷鍓嶇紑鍘嬭繃 Key 缁戝尯涓庨粯璁ゅ尯鍩燂紝涓斿紑鍏冲紑鍚椂鐢熸晥
        assert_eq!(
            realm_pool_tag_from(Some(INTL), Some(CN), "cn", true),
            pool_tag(INTL)
        );
        assert_eq!(
            realm_pool_tag_from(Some(CN), Some(INTL), "intl", true),
            pool_tag(CN)
        );
        // Key 缁戝尯鍘嬭繃榛樿鍖哄煙
        assert_eq!(
            realm_pool_tag_from(None, Some(INTL), "cn", true),
            pool_tag(INTL)
        );
        // 鍥介檯鐗堟睜鍏抽棴 鈫?鍥介檯鍖轰竴寰嬪洖钀藉浗鍐呮睜锛堝墠缂€/缁戝畾/榛樿涓夋潯鍏ュ彛鍚岃鍒欙級
        assert_eq!(realm_pool_tag_from(Some(INTL), None, "cn", false), pool_tag(CN));
        assert_eq!(realm_pool_tag_from(None, Some(INTL), "cn", false), pool_tag(CN));
        assert_eq!(realm_pool_tag_from(None, None, "intl", false), pool_tag(CN));
        // 鍥藉唴鍖轰笉鍙楀紑鍏冲奖鍝?        assert_eq!(realm_pool_tag_from(Some(CN), None, "intl", false), pool_tag(CN));
    }

    // ==================== issue #90 淇鈶狅細Server 娓愯繘妯″瀷绾у喎鍗?====================

    /// 鍐峰嵈琛ㄥ崟娴嬬粺涓€鐢ㄧ殑姹犳爣绛撅紙涓庣湡瀹炴睜鏃犲叧锛屽彧淇濊瘉骞惰娴嬭瘯浜掍笉涓查敭锛?    const TP: &str = "qoder_test";

    /// Server 鍐峰嵈鎸夈€屽け璐ョ墖娈点€嶆笎杩涳紙绐楀彛杩囨湡鎵嶉€掑锛変笖灏侀《锛涙垚鍔熸竻闄ゅ悗褰掗浂銆?    /// 鍐峰嵈琛ㄦ槸杩涚▼绾у叡浜潤鎬侊紝鐢ㄧ嫭鍗犳ā鍨嬪悕锛堝墠缂€ + 璁℃暟鍣級閬垮厤骞惰娴嬭瘯浜掓壈銆?    #[test]
    fn server_cooldown_progressive_capped_and_cleared() {
        static SEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let model = format!(
            "t90-prog-{}",
            SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        );
        let key = cooldown_key(TP, &model);
        assert!(model_cooling_remaining_secs(TP, &model).is_none());
        // 鐗囨 1锛氬熀鍑?30s
        note_model_server_cooldown(TP, &model);
        let r1 = model_cooling_remaining_secs(TP, &model).unwrap();
        assert!(r1 > 28 && r1 <= 30, "棣栨澶辫触搴斾负 30s 鍩哄噯锛屽疄闄?{r1}");
        // 鍚岀墖娈靛唴杩炵画璁拌处锛堜竴娆¤姹傞€愯处鍙锋崲鍙峰満鏅紝绐楀彛鏈繃鏈燂級锛?        // 涓嶉€掑鐗囨鏁帮紝绐楀彛浠呭欢闀匡紙鍓╀綑浠?鈮?0s锛岀粷涓嶇炕鍊嶏級
        for _ in 0..4 {
            note_model_server_cooldown(TP, &model);
        }
        let (_, fails) = *cooldown_map()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .get(&key)
            .unwrap();
        assert_eq!(fails, 1, "绐楀彛鏈繃鏈熸椂杩炵画璁拌处涓嶅緱閫掑鐗囨鏁?);
        // 浜轰负鎺ㄨ繘鍒扮獥鍙ｈ繃鏈燂紙涓嶇湡绛?30s锛夛細鐗囨 2 鈫?缈诲€?60s
        cooldown_map()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .insert(key.clone(), (Instant::now() - Duration::from_secs(1), 1));
        note_model_server_cooldown(TP, &model);
        let r2 = model_cooling_remaining_secs(TP, &model).unwrap();
        assert!(r2 > 55 && r2 <= 60, "杩囨湡鍚庢柊鐗囨搴旂炕鍊嶈嚦 60s锛屽疄闄?{r2}");
        // 杩炵画澶辫触鐗囨鑷冲皝椤讹細绐楀彛鎭?鈮?480s
        for _ in 0..10 {
            let cur = cooldown_map()
                .lock()
                .unwrap_or_else(|e| e.into_inner())
                .get(&key)
                .copied()
                .unwrap();
            cooldown_map()
                .lock()
                .unwrap_or_else(|e| e.into_inner())
                .insert(key.clone(), (Instant::now() - Duration::from_secs(1), cur.1));
            note_model_server_cooldown(TP, &model);
        }
        let capped = model_cooling_remaining_secs(TP, &model).unwrap();
        assert!(capped <= SERVER_COOLDOWN_MAX_SECS, "鍐峰嵈绐楀彛搴斿皝椤?480s锛屽疄闄?{capped}");
        // 鎴愬姛娓呴櫎 鈫?鏃犲喎鍗达紙鐗囨璁℃暟闅忎箣褰掗浂锛?        clear_model_cooldown(TP, &model);
        assert!(model_cooling_remaining_secs(TP, &model).is_none());
    }

    /// 鎺掗槦閫€閬匡紙note_model_cooldown锛変笉缂╃煭鏃㈡湁 Server 鍐峰嵈绐楀彛锛氭帓闃熷缓璁€?    /// 锛堥挸鍒?鈮?0s锛夊埌杈炬椂鑻ュ苟鍙戣姹傚垰璁颁簡鏇撮暱鐨?Server 绐楀彛锛屽簲鍙栬緝澶ц€呫€?    #[test]
    fn queued_cooldown_does_not_shorten_server_window() {
        static SEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let model = format!(
            "t90-queue-{}",
            SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        );
        // 涓ゆ Server 澶辫触锛堝悓涓€鐗囨鍐咃級鈫?绐楀彛缁存寔鍩哄噯 ~30s 涓嶅悗寤?        note_model_server_cooldown(TP, &model);
        note_model_server_cooldown(TP, &model);
        let before = model_cooling_remaining_secs(TP, &model).unwrap();
        // 鎺掗槦閫€閬垮缓璁?5s锛氫笉寰楁妸 60s 绐楀彛缂╃煭
        note_model_cooldown(TP, &model, 5);
        let after = model_cooling_remaining_secs(TP, &model).unwrap();
        assert!(
            after >= before.saturating_sub(1),
            "鎺掗槦寤鸿鍊间笉寰楃缉鐭棦鏈?Server 绐楀彛锛坽before} 鈫?{after}锛?
        );
        clear_model_cooldown(TP, &model);
    }

    /// 鍥炲綊锛氭帓闃熼€€閬垮厛鎻掑叆 fails=0 鏉＄洰锛坣ote_model_cooldown 鐨?or_insert 璺緞锛夛紝
    /// 闅忓悗 Server 澶辫触杩涘叆 and_modify 鈥斺€?fails=0 涓嶅緱涓嬫孩锛堟浘涓?`*fails - 1`锛?    /// debug panic / release 鍐峰嵈琚敊璇帹鍒?480s锛夛紝搴斾繚鎸佸熀鍑?30s 涓旇鏁颁笉鍔?    #[test]
    fn server_cooldown_after_queued_only_entry_no_underflow() {
        static SEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let model = format!(
            "t90-queue0-{}",
            SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        );
        // 鎺掗槦閫€閬垮厛钀芥潯鐩細fails = 0
        note_model_cooldown(TP, &model, 5);
        // Server 澶辫触锛氱獥鍙ｆ湭杩囨湡锛?s 鍐咃級涓嶉€掑璁℃暟锛屽熀鍑?30s 鍏滃簳
        note_model_server_cooldown(TP, &model);
        let r = model_cooling_remaining_secs(TP, &model).unwrap();
        assert!(r > 28 && r <= 30, "fails=0 鏃跺簲涓?30s 鍩哄噯绐楀彛锛屽疄闄?{r}");
        let (_, fails) = *cooldown_map()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .get(&cooldown_key(TP, &model))
            .unwrap();
        assert_eq!(fails, 0, "绐楀彛鏈繃鏈熶笉寰楅€掑澶辫触璁℃暟");
        clear_model_cooldown(TP, &model);
    }

    /// 鍥炲綊閿侊紙鏍瑰洜锛氬喎鍗磋〃瑁稿悕鍋氶敭锛夆€斺€斿悓鍚嶆ā鍨嬪湪涓ゅ尯鍚勮嚜鍐峰嵈锛屼簰涓嶅奖鍝嶏細
    /// 鍥藉唴鍖烘寕涓婄殑鎺掗槦绐楀彛涓嶅緱鎶婂浗闄呭尯璇锋眰鎵撴垚銆宷oder-intl/x cooling down銆嶏紱
    /// 鍖哄墠缂€褰㈡€侊紙`qoder-intl/x`锛変笌瑁稿悕鎶樺彔涓哄悓涓€鏉＄洰锛堟竻鍐峰嵈涓嶄細婕忔竻锛夈€?    #[test]
    fn model_cooldown_is_region_scoped() {
        static SEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let model = format!(
            "t91-region-{}",
            SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        );
        note_model_cooldown("qoder_cn", &model, 60);
        assert!(
            model_cooling_remaining_secs("qoder_intl", &model).is_none(),
            "鍥藉唴鍖哄喎鍗翠笉寰椾紶鏌撳埌鍥介檯鍖?
        );
        assert!(model_cooling_remaining_secs("qoder_cn", &model).is_some());
        // 鍖哄墠缂€涓庤８鍚嶅悓閿細甯﹀墠缂€鏌ヨ鍛戒腑鍚屼竴绐楀彛
        let prefixed = format!("qoder-intl/{model}");
        note_model_cooldown("qoder_intl", &prefixed, 30);
        assert!(model_cooling_remaining_secs("qoder_intl", &model).is_some());
        // 娓呭喎鍗村鍓嶇紑褰㈡€佸悓鏍风敓鏁堬紙鎴愬姛鍗虫竻涓嶇暀娈嬫潯锛?        clear_model_cooldown("qoder_intl", &model);
        assert!(model_cooling_remaining_secs("qoder_intl", &prefixed).is_none());
        clear_model_cooldown("qoder_cn", &model);
    }

    /// 鍐峰嵈鍓╀綑绉掓暟鍚戜笂鍙栨暣锛氬墿浣欎笉瓒?1s 鏃朵笉寰楁姤 0锛堟棫瀹炵幇 `as_secs()` 鎴柇锛?    /// 瀹㈡埛绔寜銆宺etry after 0s銆嶇珛鍗抽噸璇曞張浼氭挒鍦ㄧ獥鍙ｉ噷锛夛紝杩囨湡鎵嶈繑鍥?None
    #[test]
    fn cooling_remaining_rounds_up_and_expires() {
        static SEQ: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
        let model = format!(
            "t91-ceil-{}",
            SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
        );
        let key = cooldown_key(TP, &model);
        // 鍓╀綑 300ms锛氬悜涓婂彇鏁?= 1s锛堢粷涓?0锛?        cooldown_map()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .insert(key.clone(), (Instant::now() + Duration::from_millis(300), 1));
        assert_eq!(model_cooling_remaining_secs(TP, &model), Some(1));
        // 宸茶繃鏈?鈫?None锛堟畫鐣欐潯鐩寜鏃犲喎鍗村鐞嗭級
        cooldown_map()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .insert(key, (Instant::now() - Duration::from_millis(1), 1));
        assert!(model_cooling_remaining_secs(TP, &model).is_none());
    }

    /// issue #82 T2.3锛歝redits 澶嶆暟浼樺厛锛堟柊鐗堝瓧娈碉級锛屽崟鏁?credit 涓烘棫鐗堝厹搴?    #[test]
    fn extract_billing_prefers_plural_credits() {
        let u = json!({"credits": 12.5, "credit": 0, "original_credits": 25.0});
        let (c, o) = extract_billing(Some(&u));
        assert_eq!(c, Some(12.5));
        assert_eq!(o, Some(25.0));
        // 浠呮湁鏃х増鍗曟暟瀛楁鏃跺厹搴曞彲璇伙紙鏂拌皟鐢ㄦ柟 None 缂虹渷涓嶅啀璧版璺級
        let old = json!({"credit": 7});
        let (c, o) = extract_billing(Some(&old));
        assert_eq!(c, Some(7.0));
        assert_eq!(o, None);
    }

    /// issue #82 T2.3锛氬弻瀛楁鍧囩己 鈫?None锛堣皟鐢ㄦ柟涓嶅叆璐︼紝涓嶅緱浼€?0锛?    #[test]
    fn extract_billing_missing_fields_yields_none() {
        assert_eq!(extract_billing(None), (None, None));
        let empty = json!({"prompt_tokens": 10, "completion_tokens": 5});
        assert_eq!(extract_billing(Some(&empty)), (None, None));
        let nulls = json!({"credits": null});
        assert_eq!(extract_billing(Some(&nulls)), (None, None));
    }

    /// issue #82 T2.3锛氳礋鍊?闈炴湁闄愬€艰涓轰笉鍙俊锛屾暣浣撲笉鍏ヨ处
    #[test]
    fn extract_billing_rejects_negative() {
        let neg = json!({"credits": -3.0});
        assert_eq!(extract_billing(Some(&neg)), (None, None));
        let neg_pair = json!({"credits": 5.0, "original_credits": -1.0});
        let (c, o) = extract_billing(Some(&neg_pair));
        assert_eq!(c, Some(5.0));
        assert_eq!(o, None);
    }

    /// 浼氳瘽 preview 鍓ョ system-reminder 娉ㄥ叆鍧椾笌 <user_input> 鍖呰９鏍囩锛?    /// agent 瀹㈡埛绔妸鎻愰啋鎷煎湪姝ｆ枃鍓嶃€佽緭鍏ョ敤鏍囩鍖呰９锛宲review 蹇呴』鍙栧墺绂诲悗鐨?    /// 鐢ㄦ埛鍘熻瘽锛堝鍧?/ 璺ㄨ / 鍓嶇疆娈嬬暀绌虹櫧锛夈€?    #[test]
    fn session_preview_strips_system_reminder_blocks() {
        // 鍏稿瀷褰㈡€侊細澶氬潡 reminder 鍓嶇疆 + <user_input> 鍖呰９鐨勭敤鎴峰師璇?        let peek = json!({"messages": [{"role": "user", "content":
            "<system-reminder>\nTodos have changed...\n# Todos\n- x\n</system-reminder>\n\n<system-reminder>The maximum number of terminals is 5</system-reminder>\n<user_input>\n璇翠竴涓?00瀛楃瑧璇漒n</user_input>"}]});
        assert_eq!(session_preview(&peek), "璇翠竴涓?00瀛楃瑧璇?);

        // 浠?<user_input> 鍖呰９銆佹棤 reminder
        let wrapped = json!({"messages": [{"role": "user", "content":
            "<user_input>鍐欎竴涓?00瀛楃瑧璇?/user_input>"}]});
        assert_eq!(session_preview(&wrapped), "鍐欎竴涓?00瀛楃瑧璇?);

        // 鍓ョ鍚庝粎鍓╃┖鐧?鈫?绌轰覆锛堣皟鐢ㄦ柟鎸夋棤 preview 澶勭悊锛屼笉灞曠ず娉ㄥ叆鍐呭锛?        let only_reminder = json!({"messages": [{"role": "user", "content":
            "<system-reminder>绾敞鍏?/system-reminder>"}]});
        assert_eq!(session_preview(&only_reminder), "");

        // 鏃?reminder 鐨勬櫘閫氭秷鎭笉鍙楀奖鍝嶏紱鏈潯 user 鎵嶆槸鍙栧€兼潵婧?        let plain = json!({"messages": [
            {"role": "user", "content": "绗竴鏉?},
            {"role": "assistant", "content": "鍥炲"},
            {"role": "user", "content": "<system-reminder>x</system-reminder> 鍐欎竴涓?00瀛楃瑧璇?}
        ]});
        assert_eq!(session_preview(&plain), "鍐欎竴涓?00瀛楃瑧璇?);

        // reminder 涔嬪悗鍐嶆棤姝ｆ枃 鈫?绌猴紱reminder 鍐呭惈 "</system-reminder>" 瀛楁牱涔熸寜鏁村潡鍖归厤锛堥潪璐┆锛?        let empty_tail = json!({"messages": [{"role": "user", "content":
            "鍓嶆枃<system-reminder>娉ㄥ叆</system-reminder>  \n"}]});
        assert_eq!(session_preview(&empty_tail), "鍓嶆枃");
    }

    /// 杩滅▼鐩綍娴嬭瘯鏉＄洰锛坅dopt_remote 鎺ュ彈鐨勬渶灏忓悎娉曚俊灏佽浇鑽凤級
    fn remote_entry(key: &str, display: &str, factor: f64) -> Value {
        json!({
            "key": key,
            "display_name": display,
            "enable": true,
            "is_vl": false,
            "is_reasoning": true,
            "price_factor": factor,
            "max_input_tokens": 128000,
            "source": "remote",
        })
    }

    /// G4 纭畾鎬у垽瀹?remote 鎬侊細娉ㄥ叆鐙湁鍓嶇紑锛圱waG4锛夌殑鍙屽尯杩滅▼鐩綍锛?    /// 椤哄簭瑕嗙洊 entry_is_global_only 鐨勫叏閮ㄥ垎鏀€?    /// adopt_remote 鍐欒繘绋嬬骇鍏变韩鐩綍涓旇繙绋嬮潪绌烘椂浼氭浛鎹㈤潤鎬佸厹搴曗€斺€斿繀椤?    /// 鎸?catalog_test_guard 鐙崰骞跺湪閫€鍑猴紙鍚?panic锛夋椂鑷姩澶嶄綅鍥炶惤鍏滃簳锛?    /// 鍚﹀垯浼氭薄鏌撳苟琛岃繍琛岀殑鍏朵粬鐩綍娴嬭瘯锛堝 qoder_upstream 鐨?list 鍘婚噸锛夈€?    #[test]
    fn entry_is_global_only_remote_states() {
        let _catalog = qoder_upstream::catalog_test_guard();
        // 鈶?CN 杩滅▼鐙湁锛歭ist 鏍囨敞 "cn"锛圙lobal 渚у畬鍏ㄦ棤姝?id锛夆啋 蹇呴潪涓撳睘
        qoder_upstream::adopt_remote(
            qoder_upstream::QoderRegion::Cn,
            &json!({"statusCodeValue": 200,
                    "chat": [remote_entry("twa4cn_key", "TwaG4CnOnly", 0.5)]}),
        )
        .unwrap();
        let entry = qoder_upstream::resolve("TwaG4CnOnly", qoder_upstream::QoderRegion::Cn)
            .expect("CN 杩滅▼鐩綍搴斿懡涓?);
        assert!(!entry_is_global_only("TwaG4CnOnly", &entry));

        // 鈶?Global 杩滅▼鐙湁锛圕N 渚ч浂鍙緱璇佹嵁锛夛細涓よ矾 resolve 鍚岃惤 Global 鏉＄洰
        //    鈫?fail-closed 鍒や笓灞?        qoder_upstream::adopt_remote(
            qoder_upstream::QoderRegion::Global,
            &json!({"statusCodeValue": 200,
                    "chat": [remote_entry("twa4g_key", "TwaG4GlobalOnly", 0.7)]}),
        )
        .unwrap();
        let entry =
            qoder_upstream::resolve("TwaG4GlobalOnly", qoder_upstream::QoderRegion::Cn)
                .expect("鍙屽尯鍏滃簳搴斿懡涓?Global 鐙湁鏉＄洰");
        assert!(entry_is_global_only("TwaG4GlobalOnly", &entry));

        // 鈶?涓ゅ尯鍚屽悕浣嗗０鏄庝笉鍚岋紙Global 鍊嶇巼 0.7 / CN 鍊嶇巼 0.3锛夛細list 鏍囨敞琚?        //    Global 鍚炲苟涓?"global"锛屼絾涓よ矾 resolve 鍛戒腑涓嶅悓鏉＄洰 鈫?CN 杩滅▼
        //    纭畾鍙緱 鈫?闈炰笓灞烇紙璇佹嵁鈶★紝涓嶅啀渚濊禆鍊煎叏绛夊亣璁剧殑鍙嶅悜鎺ㄦ柇锛?        qoder_upstream::adopt_remote(
            qoder_upstream::QoderRegion::Global,
            &json!({"statusCodeValue": 200,
                    "chat": [remote_entry("twa4same_key", "TwaG4Same", 0.7)]}),
        )
        .unwrap();
        qoder_upstream::adopt_remote(
            qoder_upstream::QoderRegion::Cn,
            &json!({"statusCodeValue": 200,
                    "chat": [remote_entry("twa4same_key", "TwaG4Same", 0.3)]}),
        )
        .unwrap();
        let entry = qoder_upstream::resolve("TwaG4Same", qoder_upstream::QoderRegion::Cn)
            .expect("CN 杩滅▼鐩綍搴斿懡涓?);
        assert!(!entry_is_global_only("TwaG4Same", &entry));

        // 鈶?涓ゅ尯鍚屽悕涓斿悓鍊硷紙鏃с€屽悓鍚嶅繀寮傘€嶅亣璁捐鎵撶牬鐨勫満鏅級锛氱‘瀹氭€ц瘉鎹己澶?        //    鈫?绛栫暐鎬у垽涓撳睘锛坒ail-closed锛岃涓轰笌鏃х増涓€鑷淬€佷緷鎹敼涓烘樉寮忕瓥鐣ワ級
        qoder_upstream::adopt_remote(
            qoder_upstream::QoderRegion::Global,
            &json!({"statusCodeValue": 200,
                    "chat": [remote_entry("twa4same_key", "TwaG4Same", 0.3)]}),
        )
        .unwrap();
        let entry = qoder_upstream::resolve("TwaG4Same", qoder_upstream::QoderRegion::Cn)
            .expect("CN 杩滅▼鐩綍搴斿懡涓?);
        assert!(entry_is_global_only("TwaG4Same", &entry));
    }
}

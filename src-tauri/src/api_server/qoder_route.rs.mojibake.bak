                        pool_tag,
                        &picked.uid,
                        reader,
                        &peek,
                        &entry,
                        &model_key,
                        &model_source,
                        &tried,
                        allowed_set.as_ref(),
                        dedicated.as_deref(),
                        &envelope_ids,
                    ) {
                        Ok(w) => w,
                        Err(()) => {
                            state.qoder_pool_for(pool_tag).note_error(&picked.uid, ErrKind::Server);
                            break;
                        }
                    };
                    let ttfb_ms = ttfb_start.elapsed().as_millis() as u64;
                    // 瀵瑰啿璁℃暟钀藉畾 + guard 閲嶇粦锛堟帴绠℃椂鐢熸晥璐﹀彿 = 瀵瑰啿璐﹀彿锛?                    guard = settle_qoder_hedge(state, &mut race, guard, &picked.uid);
                    hedge_taken = race.takeover;
                    let win_uid = race.uid.clone();
                    // G4锛氳璐︿細璇?id 鎸夎儨鑰呬俊灏佽惤瀹氾紙race 鍦?translate 澶勮娑堣垂锛屽厛鍙栧揩鐓э級
                    let win_session_ids = race.session_ids.clone().or_else(|| envelope_ids.clone());
                    // 绔為€熻儨鑰呰婧愶紙鍘熷涓婃父琛岋級缁熶竴缈昏瘧鍚庡杺 stream_forward_ex
                    let ilines = translate_race_lines(race, err_slot.clone(), chat_id, model);
                    let (error_info, sent_any, failed_inline, usage) =
                        // Qoder 鏃?namespace 灞曞钩缂栫爜锛圧esponses 鍒嗘敮涓洪槻寰℃€у厹搴曪紝
